      Padding: (Left: 10, Right: 10);
      Visible: false;

      Group { Anchor: (Width: 30, Right: 8); LayoutMode: Middle; $C.@CheckBox #PermissionsCheck10 { @Anchor = (Width: 20, Height: 20, Vertical: 0); Value: false; } }
      Group { FlexWeight: 1; Anchor: (Vertical: 0); LayoutMode: Middle; Label #PermissionsLabel10 { Anchor: (Horizontal: 0, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } }
    }

    Group #PermissionsRow11 {
      Anchor: (Height: 36, Horizontal: 0, Bottom: 2);
      LayoutMode: Left;
      Background: (Color: #223149);
      Padding: (Left: 10, Right: 10);
      Visible: false;

      Group { Anchor: (Width: 30, Right: 8); LayoutMode: Middle; $C.@CheckBox #PermissionsCheck11 { @Anchor = (Width: 20, Height: 20, Vertical: 0); Value: false; } }
      Group { FlexWeight: 1; Anchor: (Vertical: 0); LayoutMode: Middle; Label #PermissionsLabel11 { Anchor: (Horizontal: 0, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } }
    }

    Group #PermissionsRow12 {
      Anchor: (Height: 36, Horizontal: 0, Bottom: 2);
      LayoutMode: Left;
      Background: (Color: #223149);
      Padding: (Left: 10, Right: 10);
      Visible: false;

      Group { Anchor: (Width: 30, Right: 8); LayoutMode: Middle; $C.@CheckBox #PermissionsCheck12 { @Anchor = (Width: 20, Height: 20, Vertical: 0); Value: false; } }
      Group { FlexWeight: 1; Anchor: (Vertical: 0); LayoutMode: Middle; Label #PermissionsLabel12 { Anchor: (Horizontal: 0, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } }
    }

    Group { Anchor: (Horizontal: 0, Height: 1, Top: 10, Bottom: 8); Background: (Color: #3a465c); }

    Group {
      Anchor: (Horizontal: 0, Height: 36);
      LayoutMode: Left;

      Group { FlexWeight: 1; }

      $C.@SmallSecondaryTextButton #BtnPermissionsBack {
        @Anchor = (Width: 140, Height: 32, Vertical: 0);
        Text: "Back";
      }

      Group { FlexWeight: 1; }
    }
  }
