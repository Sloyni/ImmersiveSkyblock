      Group { FlexWeight: 1; Anchor: (Vertical: 0); LayoutMode: Middle; Label #PermissionsLabel9 { Anchor: (Horizontal: 0, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } }
    }

    Group #PermissionsRow10 {
