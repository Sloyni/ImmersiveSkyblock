$C = "../Common.ui";
$Sounds = "../Sounds.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 620, Height: 640);

  #Title {
    $C.@Title #PermissionsTopTitle { @Text = "Permissions"; }
  }

  #Content {
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;
    Padding: (Full: 14);

    Label #PermissionsPopupTitle {
      Anchor: (Horizontal: 0, Height: 24, Bottom: 4);
      Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #ffffff, RenderBold: true);
      Text: "Permissions";
    }

    Label #PermissionsPopupSubtitle {
      Anchor: (Horizontal: 0, Height: 16, Bottom: 10);
      Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
      Text: "Configure permissions.";
    }

    Label #PermissionsError {
      Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
      Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #ff5555, HorizontalAlignment: Center);
      Text: "";
      Visible: false;
    }

    Group #PermissionsFollowDefaultRow {
      Anchor: (Height: 38, Horizontal: 0, Bottom: 4);
      LayoutMode: Left;
      Background: (Color: #223149);
      Padding: (Left: 10, Right: 10);
      Visible: false;

      Group {
        Anchor: (Width: 30, Right: 8);
        LayoutMode: Middle;
        $C.@CheckBox #PermissionsFollowDefaultCheck {
          @Anchor = (Width: 20, Height: 20, Vertical: 0);
          Value: true;
        }
      }

      Group {
        FlexWeight: 1;
        Anchor: (Vertical: 0);
        LayoutMode: Middle;
        Label #PermissionsFollowDefaultHint {
          Anchor: (Horizontal: 0, Height: 18, Vertical: 0);
          Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
          Text: "Follow default permissions";
        }
      }
    }

    Label #PermissionsInheritedHint {
      Anchor: (Horizontal: 0, Height: 16, Bottom: 8);
      Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #8fb4d0);
      Text: "This member currently uses default permissions.";
      Visible: false;
    }

    Group #PermissionsRow0 {
      Anchor: (Height: 36, Horizontal: 0, Bottom: 2);
      LayoutMode: Left;
      Background: (Color: #223149);
      Padding: (Left: 10, Right: 10);
      Visible: false;

      Group {
        Anchor: (Width: 30, Right: 8);
        LayoutMode: Middle;
        $C.@CheckBox #PermissionsCheck0 { @Anchor = (Width: 20, Height: 20, Vertical: 0); Value: false; }
      }

      Group { FlexWeight: 1; Anchor: (Vertical: 0); LayoutMode: Middle; Label #PermissionsLabel0 { Anchor: (Horizontal: 0, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } }
    }

    Group #PermissionsRow1 {
      Anchor: (Height: 36, Horizontal: 0, Bottom: 2);
      LayoutMode: Left;
      Background: (Color: #223149);
      Padding: (Left: 10, Right: 10);
      Visible: false;

      Group { Anchor: (Width: 30, Right: 8); LayoutMode: Middle; $C.@CheckBox #PermissionsCheck1 { @Anchor = (Width: 20, Height: 20, Vertical: 0); Value: false; } }
      Group { FlexWeight: 1; Anchor: (Vertical: 0); LayoutMode: Middle; Label #PermissionsLabel1 { Anchor: (Horizontal: 0, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } }
    }

    Group #PermissionsRow2 {
      Anchor: (Height: 36, Horizontal: 0, Bottom: 2);
      LayoutMode: Left;
      Background: (Color: #223149);
      Padding: (Left: 10, Right: 10);
      Visible: false;

