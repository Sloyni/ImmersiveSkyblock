$C = "../Common.ui";
$Sounds = "../Sounds.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 520, Height: 580);

  #Title {
    $C.@Title { @Text = "Manage languages"; }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Full: 14);

    Label #LangMgrTitle {
      Anchor: (Horizontal: 0, Height: 24, Bottom: 4);
      Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #ffffff, RenderBold: true);
      Text: "Available languages";
    }

    Label #LangMgrDescription {
      Anchor: (Horizontal: 0, Height: 16, Bottom: 12);
      Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
      Text: "Enable or disable each language.";
    }

    Label #LangMgrError {
      Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
      Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #ff5555, HorizontalAlignment: Center);
      Text: "";
      Visible: false;
    }

    Group #LangRow0 {
      Anchor: (Height: 48, Horizontal: 0, Bottom: 2);
      LayoutMode: Left;
      Background: (Color: #223149);
      Padding: (Left: 10, Right: 10);
      Visible: false;

      Group {
        Anchor: (Width: 30, Right: 8);
        LayoutMode: Middle;
        $C.@CheckBox #LangEnabled0 {
          @Anchor = (Width: 20, Height: 20, Vertical: 0);
          Value: false;
        }
      }

      Group {
        FlexWeight: 1;
        Anchor: (Vertical: 0);
        LayoutMode: Middle;
        Label #LangLabel0 {
          Anchor: (Horizontal: 0, Height: 20, Vertical: 0);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
          Text: "";
        }
      }
    }

    Group #LangRow1 {
      Anchor: (Height: 48, Horizontal: 0, Bottom: 2);
      LayoutMode: Left;
      Background: (Color: #223149);
      Padding: (Left: 10, Right: 10);
      Visible: false;

      Group {
        Anchor: (Width: 30, Right: 8);
        LayoutMode: Middle;
        $C.@CheckBox #LangEnabled1 {
          @Anchor = (Width: 20, Height: 20, Vertical: 0);
          Value: false;
        }
      }

      Group {
        FlexWeight: 1;
        Anchor: (Vertical: 0);
        LayoutMode: Middle;
        Label #LangLabel1 {
          Anchor: (Horizontal: 0, Height: 20, Vertical: 0);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
          Text: "";
        }
      }
    }

    Group #LangRow2 {
      Anchor: (Height: 48, Horizontal: 0, Bottom: 2);
      LayoutMode: Left;
      Background: (Color: #223149);
      Padding: (Left: 10, Right: 10);
      Visible: false;

      Group {
        Anchor: (Width: 30, Right: 8);
        LayoutMode: Middle;
        $C.@CheckBox #LangEnabled2 {
          @Anchor = (Width: 20, Height: 20, Vertical: 0);
          Value: false;
        }
      }

      Group {
        FlexWeight: 1;
        Anchor: (Vertical: 0);
        LayoutMode: Middle;
        Label #LangLabel2 {
          Anchor: (Horizontal: 0, Height: 20, Vertical: 0);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
          Text: "";
        }
      }
    }

    Group #LangRow3 {
      Anchor: (Height: 48, Horizontal: 0, Bottom: 2);
      LayoutMode: Left;
      Background: (Color: #223149);
      Padding: (Left: 10, Right: 10);
      Visible: false;

      Group {
        Anchor: (Width: 30, Right: 8);
        LayoutMode: Middle;
        $C.@CheckBox #LangEnabled3 {
