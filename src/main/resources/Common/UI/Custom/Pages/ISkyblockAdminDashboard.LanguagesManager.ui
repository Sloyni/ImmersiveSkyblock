      LayoutMode: Left;
      Background: (Color: #223149);
      Padding: (Left: 10, Right: 10);
      Visible: false;

      Group {
        Anchor: (Width: 30, Right: 8);
        LayoutMode: Middle;
        $C.@CheckBox #LangEnabled5 {
          @Anchor = (Width: 20, Height: 20, Vertical: 0);
          Value: false;
        }
      }

      Group {
        FlexWeight: 1;
        Anchor: (Vertical: 0);
        LayoutMode: Middle;
        Label #LangLabel5 {
          Anchor: (Horizontal: 0, Height: 20, Vertical: 0);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
          Text: "";
        }
      }
    }

    Group #LangRow6 {
      Anchor: (Height: 48, Horizontal: 0, Bottom: 2);
      LayoutMode: Left;
      Background: (Color: #223149);
      Padding: (Left: 10, Right: 10);
      Visible: false;

      Group {
        Anchor: (Width: 30, Right: 8);
        LayoutMode: Middle;
        $C.@CheckBox #LangEnabled6 {
          @Anchor = (Width: 20, Height: 20, Vertical: 0);
          Value: false;
        }
      }

      Group {
