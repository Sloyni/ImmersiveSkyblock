$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@CreateTemplateFormSection = Group {
  Anchor: (Horizontal: 0, Bottom: 14);
  LayoutMode: Top;
  Visible: false;

  Label #CreateTemplateFormTitle {
    Anchor: (Height: 24, Bottom: 6);
    Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #ffffff, RenderBold: true);
    Text: "Creer une ile";
  }

  Label #CreateTemplateFormIntro {
    Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
    Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
    Text: "Remplissez les champs puis validez pour revenir au menu principal.";
  }

  Label #CreateTemplateFormNameLabel {
    Anchor: (Height: 22, Bottom: 4);
    Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b8c7d8);
    Text: "Nom de l'ile";
  }

  $C.@TextField #CreateTemplateNameField {
    @Anchor = (Horizontal: 0, Bottom: 10);
  }

  Label #CreateTemplateFormDescriptionLabel {
    Anchor: (Height: 22, Bottom: 4);
    Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b8c7d8);
    Text: "Description";
  }

  $C.@MultilineTextField #CreateTemplateDescriptionField {
    @Anchor = (Horizontal: 0, Height: 68, Bottom: 10);
  }

  Label #CreateTemplateFormIdLabel {
    Anchor: (Height: 22, Bottom: 4);
    Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b8c7d8);
    Text: "Id unique de l'ile";
  }

  $C.@TextField #CreateTemplateIdField {
    @Anchor = (Horizontal: 0, Bottom: 10);
  }

  Label #CreateTemplateImageHint {
    Anchor: (Horizontal: 0, Bottom: 12);
    Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #6a7e94, Wrap: true);
    Text: "";
  }

  Label #CreateTemplateFormError {
    Anchor: (Horizontal: 0, Height: 24, Bottom: 6);
    Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ff5555, HorizontalAlignment: Center);
    Text: "";
    Visible: false;
  }

  Group {
    Anchor: (Horizontal: 0, Height: 48);
    LayoutMode: Left;

    Group { FlexWeight: 1; }

    $C.@SecondaryTextButton #CancelCreateTemplateFormButton {
      @Sounds = $Sounds.@ButtonsCancel;
      @Anchor = (Width: 138, Right: 8);
      Text: "Annuler";
    }

    $C.@TextButton #FinishCreateTemplateFormButton {
      @Sounds = $Sounds.@ButtonsLight;
      @Anchor = (Width: 164);
      Text: "Terminer";
    }
  }
};
