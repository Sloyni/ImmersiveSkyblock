      Group {
        FlexWeight: 1;
      }

      $C.@CancelTextButton #CloseButton {
        @Sounds = $Sounds.@ButtonsCancel;
        @Anchor = (Horizontal: 0, Height: 36, Top: 10);
        Text: "Fermer";
