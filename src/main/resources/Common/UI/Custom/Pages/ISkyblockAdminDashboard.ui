$C = "../Common.ui";
$Sounds = "../Sounds.ui";
$CreateTemplateSection = "ISkyblockAdminDashboard.CreateTemplateSection.ui";
$CreateTemplateForm = "ISkyblockAdminDashboard.CreateTemplateForm.ui";
$EditTemplateForm = "ISkyblockAdminDashboard.EditTemplateForm.ui";
$DeleteTemplateConfirm = "ISkyblockAdminDashboard.DeleteTemplateConfirm.ui";
$TemplatesSection = "ISkyblockAdminDashboard.TemplatesSection.ui";
$AddonsSection = "ISkyblockAdminDashboard.AddonsSection.ui";
$SettingsSection = "ISkyblockAdminDashboard.SettingsSection.ui";
$MobsManagerSection = "ISkyblockAdminDashboard.MobsManagerSection.ui";
$ResetsSection = "ISkyblockAdminDashboard.ResetsSection.ui";
$HomesSection = "ISkyblockAdminDashboard.HomesSection.ui";
$IslandsSection = "ISkyblockAdminDashboard.IslandsSection.ui";
$LevelsSection = "ISkyblockAdminDashboard.LevelsSection.ui";
$OreGeneratorSection = "ISkyblockAdminDashboard.OreGeneratorSection.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1050, Height: 700);

  #Title {
    $C.@Title { @Text = "ISkyblock Admin"; }
  }

  #Content {
    LayoutMode: Left;
    Padding: (Full: 0);

    // === Sidebar ===
    Group #Sidebar {
      Anchor: (Width: 250);
      LayoutMode: Top;
      Background: (Color: #111b28(0.96));
      Padding: (Left: 8, Right: 8, Top: 10, Bottom: 10);

      TextButton #SidebarNavTemplates {
        Anchor: (Horizontal: 0, Height: 34, Bottom: 0);
        Padding: (Left: 12, Right: 12);
        Text: "Templates";
        Visible: false;
        Style: (
          Default: (Background: (Color: #00000000), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #8fa4bc, RenderUppercase: true, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center)),
          Hovered: (Background: (Color: #1a2738), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #c7d9ea, RenderUppercase: true, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center)),
          Pressed: (Background: (Color: #223149), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderUppercase: true, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center)),
          Disabled: (Background: (Color: #00000000), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #56687d, RenderUppercase: true, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center)),
          Sounds: $Sounds.@ButtonsLight
        );
      }

      TextButton #SidebarNavTemplatesActive {
        Anchor: (Horizontal: 0, Height: 34, Bottom: 0);
        Padding: (Left: 12, Right: 12);
        Text: "Templates";
