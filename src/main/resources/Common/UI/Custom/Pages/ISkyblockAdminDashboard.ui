    // === Main content ===
    Group {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      Padding: (Left: 18, Right: 18, Top: 14, Bottom: 14);
      ScrollbarStyle: $C.@DefaultScrollbarStyle;

      $CreateTemplateSection.@CreateTemplateSection #CreateSection {}

      $CreateTemplateForm.@CreateTemplateFormSection #CreateTemplateForm {}

      $EditTemplateForm.@EditTemplateFormSection #EditTemplateForm {}

      $DeleteTemplateConfirm.@DeleteTemplateConfirmSection #DeleteTemplateConfirmForm {}

      $TemplatesSection.@TemplatesSection #TemplatesSection {}

      $AddonsSection.@AddonsSection #AddonsSection {}

      $SettingsSection.@SettingsSection #SettingsSection {}

      $MobsManagerSection.@MobsManagerSection #MobsManagerSection {}

      $ResetsSection.@ResetsSection #ResetsSection {}

      $HomesSection.@HomesSection #HomesSection {}

      $IslandsSection.@IslandsSection #IslandsSection {}

      $LevelsSection.@LevelsSection #LevelsSection {}

      $OreGeneratorSection.@OreGeneratorSection #OreGeneratorSection {}
