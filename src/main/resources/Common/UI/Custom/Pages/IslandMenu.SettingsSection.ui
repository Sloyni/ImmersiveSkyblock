$C = "../Common.ui";
$Sounds = "../Sounds.ui";

        @IslandMenuSettingsSection = Group {
          Anchor: (Horizontal: 0, Vertical: 0);
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;

          Group {
            Anchor: (Horizontal: 0, Bottom: 12);
            LayoutMode: Left;

            Group {
              FlexWeight: 1;
              LayoutMode: Top;

              Label #SettingsSectionTitle {
                Anchor: (Horizontal: 0, Height: 26, Bottom: 2);
                Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
                Text: "Settings";
              }

              Label #SettingsSectionDescription {
                Anchor: (Horizontal: 0, Height: 18);
                Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
                Text: "Configure your island settings.";
              }
            }
          }

          Group #SettingsSetSpawnRow {
            Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
            LayoutMode: Left;
            Background: (Color: #223149);
            Padding: (Left: 12, Right: 10);

            Group {
              FlexWeight: 1;
              Anchor: (Vertical: 0);
              LayoutMode: Middle;

              Label #SettingsSetSpawnLabel {
                Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
                Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
                Text: "Set Spawn";
              }
            }

            TextButton #BtnSetSpawn {
              Anchor: (Width: 132, Height: 32);
              Text: "Set spawn";
              Style: (
                Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                Sounds: $Sounds.@ButtonsLight
              );
            }
          }

          Group #SettingsItemDropRow {
            Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
            LayoutMode: Left;
            Background: (Color: #223149);
            Padding: (Left: 12, Right: 10);
            Visible: false;

            Group {
              FlexWeight: 1;
              Anchor: (Vertical: 0);
              LayoutMode: Middle;

              Label #SettingsItemDropLabel {
                Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
                Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
                Text: "Visitor item drop";
              }
            }

            Group {
              Anchor: (Width: 34, Right: 10);
              LayoutMode: Middle;
              $C.@CheckBox #SettingsItemDropToggle {
                @Anchor = (Width: 22, Height: 22, Vertical: 0);
                Value: false;
              }
            }
          }

          Group #SettingsMobDamageRow {
            Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
            LayoutMode: Left;
            Background: (Color: #223149);
            Padding: (Left: 12, Right: 10);
            Visible: false;

            Group {
              FlexWeight: 1;
              Anchor: (Vertical: 0);
              LayoutMode: Middle;

              Label #SettingsMobDamageLabel {
                Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
                Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
                Text: "Visitor mob damage";
              }
            }

            Group {
              Anchor: (Width: 34, Right: 10);
              LayoutMode: Middle;
              $C.@CheckBox #SettingsMobDamageToggle {
                @Anchor = (Width: 22, Height: 22, Vertical: 0);
                Value: false;
              }
            }
          }

          Group #SettingsWallsSection {
            LayoutMode: Top;

            Group #SettingsWallsTopDivider {
              Anchor: (Horizontal: 0, Height: 1, Top: 10, Bottom: 14);
              Background: (Color: #3a465c);
            }

            Group #SettingsWallsHeader {
              Anchor: (Horizontal: 0, Bottom: 12);
              LayoutMode: Left;

              Group {
                FlexWeight: 1;
                LayoutMode: Top;

                Label #SettingsWallsTitle {
                  Anchor: (Horizontal: 0, Height: 26, Bottom: 2);
                  Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
                  Text: "Walls";
                }

                Label #SettingsWallsDescription {
                  Anchor: (Horizontal: 0, Height: 18);
                  Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
                  Text: "Choose type, size and colors.";
                }
              }

              TextButton #BtnSettingsWallApply {
                Anchor: (Width: 250, Height: 32, Vertical: 0);
                Text: "Apply modifications";
                Visible: false;
                Style: (
                  Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Sounds: $Sounds.@ButtonsLight
                );
              }
            }

            Group #SettingsWallToggleRow {
              Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
              LayoutMode: Left;
              Background: (Color: #223149);
              Padding: (Left: 12, Right: 10);
              Visible: false;

              Group {
                FlexWeight: 1;
                Anchor: (Vertical: 0);
                LayoutMode: Middle;

                Label #SettingsWallToggleLabel {
                  Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
                  Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
                  Text: "Island walls";
                }
              }

              TextButton #BtnWallsToggle {
                Anchor: (Width: 160, Height: 32);
                Text: "Disable walls";
                Style: (
                  Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                  Sounds: $Sounds.@ButtonsLight
                );
              }
            }

            Group #SettingsWallsGroup {
              LayoutMode: Top;

              Group #SettingsWallTypeRow {
                Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
                LayoutMode: Left;
                Background: (Color: #223149);
                Padding: (Left: 12, Right: 10);

                Group {
                  FlexWeight: 1;
                  Anchor: (Vertical: 0);
                  LayoutMode: Middle;

                  Label #SettingsWallTypeLabel {
                    Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
                    Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
                    Text: "Wall Type";
                  }
                }

                DropdownBox #SettingsWallTypeDropdown {
                  Anchor: (Width: 180, Height: 32);
                  Style: (...$C.@DefaultDropdownBoxStyle);
                  Value: "none";
                }
              }

              Group #SettingsWallSizeRow {
                Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
                LayoutMode: Left;
                Background: (Color: #223149);
                Padding: (Left: 12, Right: 10);

                Group {
                  FlexWeight: 1;
                  Anchor: (Vertical: 0);
                  LayoutMode: Middle;

                  Label #SettingsWallSizeLabel {
                    Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
                    Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
                    Text: "Wall Size";
                  }
                }

                SliderNumberField #SettingsWallSizeField {
                  Anchor: (Width: 220, Height: 5, Right: 0);
                  SliderStyle: $C.@DefaultSliderStyle;
                  NumberFieldStyle: $C.@DefaultInputFieldStyle;
                  NumberFieldContainerAnchor: (Left: 10, Width: 42, Height: 15);
                  Min: 2;
                  Max: 16;
                  Step: 1;
                }
              }

              Group #SettingsWallColorsRow {
                Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
                LayoutMode: Left;
                Background: (Color: #223149);
                Padding: (Left: 12, Right: 10);

                Group {
                  FlexWeight: 1;
                  Anchor: (Vertical: 0);
                  LayoutMode: Middle;

                  Label #SettingsWallColorsLabel {
                    Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
                    Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
                    Text: "Walls Colors";
                  }
                }

                DropdownBox #SettingsWallColorDropdown {
                  Anchor: (Width: 160, Height: 32, Right: 6);
                  Style: (...$C.@DefaultDropdownBoxStyle);
                  Value: "red";
                }

                TextButton #BtnSettingsWallColorAdd {
                  Anchor: (Width: 108, Height: 32, Right: 6);
                  Text: "Add";
                  Style: (
                    Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                    Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                    Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                    Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                    Sounds: $Sounds.@ButtonsLight
                  );
                }

                TextButton #BtnSettingsWallColorClear {
                  Anchor: (Width: 108, Height: 32);
                  Text: "Clear";
                  Style: (
                    Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                    Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                    Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                    Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                    Sounds: $Sounds.@ButtonsLight
                  );
                }
              }

              Group #SettingsWallColorsListRow {
                Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
                LayoutMode: Left;
                Background: (Color: #223149);
                Padding: (Left: 12, Right: 10);

                Group {
                  FlexWeight: 1;
                  Anchor: (Vertical: 0);
                  LayoutMode: Top;

                  Label #SettingsWallColorsListLabel {
                    Anchor: (Horizontal: 0, Height: 18, Top: 8);
                    Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #8fa5b7, RenderBold: true);
                    Text: "Selected colors cycle";
                  }

                  Label #SettingsWallColorsListValue {
                    Anchor: (Horizontal: 0, Height: 18, Top: 4);
                    Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, Wrap: false);
                    Text: "-";
                  }
                }
              }

            }

          }

          Group #SettingsBeforeResetDivider {
            Anchor: (Horizontal: 0, Height: 1, Top: 10, Bottom: 14);
            Background: (Color: #3a465c);
          }

          Group {
            Anchor: (Horizontal: 0, Bottom: 12);
            LayoutMode: Left;

            Group {
              FlexWeight: 1;
              LayoutMode: Top;

              Label #SettingsResetTitle {
                Anchor: (Horizontal: 0, Height: 26, Bottom: 2);
                Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
                Text: "Reset";
              }

              Label #SettingsResetDescription {
                Anchor: (Horizontal: 0, Height: 18);
                Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
                Text: "Delete island after all safety checks pass.";
              }
            }
          }

          Group #SettingsResetRow {
            Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
            LayoutMode: Left;
            Background: (Color: #223149);
            Padding: (Left: 12, Right: 10);

            Group {
              FlexWeight: 1;
              Anchor: (Vertical: 0);
              LayoutMode: Top;

              Label #SettingsResetCountLabel {
                Anchor: (Horizontal: 0, Height: 20, Top: 8);
                Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #8fa5b7, RenderBold: true);
                Text: "Resets remaining";
              }

              Label #SettingsResetCountValue {
                Anchor: (Horizontal: 0, Height: 18, Top: 2);
                Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true);
                Text: "0";
              }
            }

            TextButton #BtnResetIsland {
              Anchor: (Width: 160, Height: 32);
              Text: "Reset island";
              Style: (
                Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                Sounds: $Sounds.@ButtonsLight
              );
            }
          }

          Group {
            Anchor: (Horizontal: 0, Height: 1, Top: 10, Bottom: 14);
            Background: (Color: #3a465c);
          }

          Group {
            Anchor: (Horizontal: 0, Bottom: 12);
            LayoutMode: Left;

            Group {
              FlexWeight: 1;
              LayoutMode: Top;

              Label #SettingsLeaveTitle {
                Anchor: (Horizontal: 0, Height: 26, Bottom: 2);
                Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
                Text: "Leave island";
              }

              Label #SettingsLeaveDescription {
                Anchor: (Horizontal: 0, Height: 18);
                Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
                Text: "Leave your current island and return to lobby.";
              }
            }
          }

          Group #SettingsLeaveRow {
            Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
            LayoutMode: Left;
            Background: (Color: #223149);
            Padding: (Left: 12, Right: 10);

            Group {
              FlexWeight: 1;
              Anchor: (Vertical: 0);
              LayoutMode: Middle;

              Label #SettingsLeaveHint {
                Anchor: (Horizontal: 0, Height: 18, Vertical: 0);
                Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #8fa5b7);
                Text: "You can leave only when requirements are met.";
              }
            }

            TextButton #BtnLeaveIsland {
              Anchor: (Width: 160, Height: 32);
              Text: "Leave island";
              Style: (
                Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
                Sounds: $Sounds.@ButtonsLight
              );
            }
          }

          Group {
            Anchor: (Horizontal: 0, Height: 10);
          }
        };
