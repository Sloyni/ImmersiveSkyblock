$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@IslandsSection = Group {
  LayoutMode: Top;
  Visible: false;

  Group {
    Anchor: (Horizontal: 0, Height: 1, Top: 10, Bottom: 14);
    Background: (Color: #3a465c);
  }

  Group {
    Anchor: (Horizontal: 0, Bottom: 4);
    LayoutMode: Top;

    Label #IslandsPlayersSectionTitle {
      Anchor: (Horizontal: 0, Height: 26, Bottom: 4);
      Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
      Text: "Player islands";
    }

    Label #IslandsSectionDescription {
      Anchor: (Horizontal: 0, Height: 18);
      Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
      Text: "Browse and open the island control page for player islands.";
    }
  }

  Group #IslandsSearchRow {
    Anchor: (Height: 44, Horizontal: 0, Bottom: 6);
    LayoutMode: Left;
    Padding: (Left: 0, Right: 0, Top: 6, Bottom: 6);

    Group {
      FlexWeight: 1;
      Anchor: (Height: 32, Right: 8);

      $C.@TextField #IslandsSearchField {
        @Anchor = (Horizontal: 0, Height: 32, Vertical: 0);
      }
    }

    TextButton #IslandsSearchButton {
      Anchor: (Width: 96, Height: 32);
      Text: "Search";
      Style: (
        Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Sounds: $Sounds.@ButtonsLight
      );
    }
  }

  Group #IslandsPlayerRow0 { Anchor: (Height: 56, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 12, Right: 10); Visible: false;
    Group { FlexWeight: 1; Anchor: (Vertical: 0, Right: 8); LayoutMode: Middle; Group { LayoutMode: Top;
      Label #IslandsPlayerName0 { Anchor: (Horizontal: 0, Height: 20); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true); Text: "Player"; }
      Label #IslandsPlayerIsland0 { Anchor: (Horizontal: 0, Height: 16); Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3); Text: "Island"; }
    } }
    TextButton #IslandsPlayerView0 { Anchor: (Width: 112, Height: 32); Text: "View island"; Style: (Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Sounds: $Sounds.@ButtonsLight); }
