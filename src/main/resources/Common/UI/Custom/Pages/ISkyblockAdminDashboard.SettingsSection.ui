$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@SettingsSection = Group {
  LayoutMode: Top;
  Visible: false;

  Group {
    Anchor: (Horizontal: 0, Height: 1, Top: 10, Bottom: 10);
    Background: (Color: #3a465c);
  }

  Group {
    Anchor: (Horizontal: 0, Bottom: 12);
    LayoutMode: Left;

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #SettingsGeneralSectionTitle {
        Anchor: (Horizontal: 0, Height: 26, Bottom: 2);
        Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
        Text: "General";
      }

      Label #SettingsGeneralSectionDescription {
        Anchor: (Horizontal: 0, Height: 18);
        Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
        Text: "General island actions.";
      }
    }
  }

  Group #SettingsPlaceSpawnRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #SettingsPlaceSpawnLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Coordonnees du lobby";
      }
    }

    TextButton #SettingsPlaceSpawnButton {
      Anchor: (Width: 132, Height: 32);
      Text: "Placer le lobby";
      Style: (
        Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Sounds: $Sounds.@ButtonsLight
      );
    }
  }

  Group {
    Anchor: (Horizontal: 0, Height: 1, Top: 10, Bottom: 14);
    Background: (Color: #3a465c);
  }

  Group {
    Anchor: (Horizontal: 0, Bottom: 12);
    LayoutMode: Left;

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #SettingsSectionTitle {
        Anchor: (Horizontal: 0, Height: 26, Bottom: 2);
        Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
        Text: "Island settings";
      }

      Label #SettingsSectionDescription {
        Anchor: (Horizontal: 0, Height: 18);
        Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
        Text: "Configure global island behavior.";
      }
    }
  }

  Group #SettingsSpawnProtectionRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      Anchor: (Width: 34, Right: 10);
      LayoutMode: Middle;
      $C.@CheckBox #SettingsSpawnProtectionToggle {
        @Anchor = (Width: 22, Height: 22, Vertical: 0);
        Value: false;
      }
    }

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #SettingsSpawnProtectionLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Protection du spawn contre les mobs";
      }
    }
  }

  Group #SettingsProtectionRadiusRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);
    Visible: false;

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #SettingsProtectionRadiusLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Rayon de protection a partir du centre de l'ile";
      }
    }

    Group #SettingsProtectionRadiusFieldBorder {
      Anchor: (Width: 122, Height: 32, Right: 8);
      Padding: (Full: 2);

      $C.@TextField #SettingsProtectionRadiusField {
        @Anchor = (Horizontal: 0, Height: 28, Vertical: 0);
      }
    }

    Group #SettingsProtectionRadiusApplyBox {
      Anchor: (Width: 32, Height: 32);
      Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12);
      Visible: false;
      Button #SettingsProtectionRadiusApply {
        Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0);
        Style: (
          Default: (Background: (TexturePath: "../icons/check.png", Color: #9bb4ce)),
          Hovered: (Background: (TexturePath: "../icons/check.png", Color: #ffffff)),
          Pressed: (Background: (TexturePath: "../icons/check.png", Color: #7f9cb9)),
          Disabled: (Background: (TexturePath: "../icons/check.png", Color: #5a6d80))
        );
      }
    }
  }

  Group #SettingsTemplatesYRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #SettingsTemplatesYLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Hauteur de generation des iles";
      }
    }

    Group #SettingsTemplatesYFieldBorder {
      Anchor: (Width: 122, Height: 32, Right: 8);
      Padding: (Full: 2);

      $C.@TextField #SettingsTemplatesYField {
        @Anchor = (Horizontal: 0, Height: 28, Vertical: 0);
      }
    }

    Group #SettingsTemplatesYApplyBox {
      Anchor: (Width: 32, Height: 32);
      Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12);
      Visible: false;
      Button #SettingsTemplatesYApply {
        Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0);
        Style: (
          Default: (Background: (TexturePath: "../icons/check.png", Color: #9bb4ce)),
          Hovered: (Background: (TexturePath: "../icons/check.png", Color: #ffffff)),
          Pressed: (Background: (TexturePath: "../icons/check.png", Color: #7f9cb9)),
          Disabled: (Background: (TexturePath: "../icons/check.png", Color: #5a6d80))
        );
      }
    }
  }

  Group #SettingsVoidKillItemsRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      Anchor: (Width: 34, Right: 10);
      LayoutMode: Middle;
      $C.@CheckBox #SettingsVoidKillItemsToggle {
        @Anchor = (Width: 22, Height: 22, Vertical: 0);
        Value: false;
      }
    }

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #SettingsVoidKillItemsLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Supprimer les items dans le vide";
      }
    }
  }

  Group #SettingsVoidKillEntitiesRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      Anchor: (Width: 34, Right: 10);
      LayoutMode: Middle;
      $C.@CheckBox #SettingsVoidKillEntitiesToggle {
        @Anchor = (Width: 22, Height: 22, Vertical: 0);
        Value: false;
      }
    }

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #SettingsVoidKillEntitiesLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Supprimer les entites dans le vide";
      }
    }
  }

  Group #SettingsVoidTeleportRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      Anchor: (Width: 34, Right: 10);
      LayoutMode: Middle;
      $C.@CheckBox #SettingsVoidTeleportToggle {
        @Anchor = (Width: 22, Height: 22, Vertical: 0);
        Value: false;
      }
    }

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #SettingsVoidTeleportLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Teleportation vers l'ile quand le joueur tombe dans le vide";
      }
    }
  }

  Group {
    Anchor: (Horizontal: 0, Height: 1, Top: 16, Bottom: 14);
    Background: (Color: #3a465c);
  }

  Group {
    Anchor: (Horizontal: 0, Bottom: 12);
    LayoutMode: Left;

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #SettingsLangSectionTitle {
        Anchor: (Horizontal: 0, Height: 26, Bottom: 2);
        Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
        Text: "Languages";
      }

      Label #SettingsLangSectionDescription {
        Anchor: (Horizontal: 0, Height: 18);
        Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
        Text: "Configure language behavior.";
      }
    }
  }

  Group #SettingsDefaultLangRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #SettingsDefaultLangLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Administration language";
      }
    }

    Group {
      Anchor: (Width: 160, Height: 32, Right: 0);
      LayoutMode: Middle;

      DropdownBox #SettingsDefaultLangDropdown {
        Anchor: (Horizontal: 0, Height: 32, Vertical: 0);
        Style: $C.@DefaultDropdownBoxStyle;
      }
    }
  }

  Group #SettingsAutoLangMatchRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      Anchor: (Width: 34, Right: 10);
      LayoutMode: Middle;
      $C.@CheckBox #SettingsAutoLangMatchToggle {
        @Anchor = (Width: 22, Height: 22, Vertical: 0);
        Value: false;
      }
    }

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #SettingsAutoLangMatchLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Auto-detect player language";
      }
    }
  }

  Group #SettingsManageLangsRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #SettingsManageLangsLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Available languages";
      }
    }

    TextButton #SettingsManageLangs {
      Anchor: (Width: 84, Height: 32);
      Text: "Gerer";
      Style: (
        Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Sounds: $Sounds.@ButtonsLight
      );
    }
  }

  Group #SettingsFallbackLangRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #SettingsFallbackLangLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Fallback language";
      }
    }

    Group {
      Anchor: (Width: 160, Height: 32, Right: 0);
      LayoutMode: Middle;

      DropdownBox #SettingsFallbackLangDropdown {
        Anchor: (Horizontal: 0, Height: 32, Vertical: 0);
        Style: $C.@DefaultDropdownBoxStyle;
      }
    }
  }

  Group #SettingsTranslateTemplatesRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      Anchor: (Width: 34, Right: 10);
      LayoutMode: Middle;
      $C.@CheckBox #SettingsTranslateTemplatesToggle {
        @Anchor = (Width: 22, Height: 22, Vertical: 0);
        Value: false;
      }
    }

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #SettingsTranslateTemplatesLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Translate island templates";
      }
    }
  }

  Label #SettingsSectionError {
    Anchor: (Horizontal: 0, Height: 24, Top: 8);
    Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ff5555, HorizontalAlignment: Center);
    Text: "";
    Visible: false;
  }
};
