$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@HomesSection = Group {
  LayoutMode: Top;
  Visible: false;

  Group #HomesTopDivider {
    Anchor: (Horizontal: 0, Height: 1, Top: 10, Bottom: 14);
    Background: (Color: #3a465c);
  }

  Group {
    Anchor: (Horizontal: 0, Bottom: 12);
    LayoutMode: Left;

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #HomesSectionTitle {
        Anchor: (Horizontal: 0, Height: 26, Bottom: 2);
        Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
        Text: "Homes";
      }

      Label #HomesSectionDescription {
        Anchor: (Horizontal: 0, Height: 18);
        Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
        Text: "Manage default max homes and per-player max homes.";
      }
    }
  }

  Group #HomesMaxHomesRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #HomesMaxHomesLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Default max homes";
      }
    }

    Group #HomesMaxHomesFieldBorder {
      Anchor: (Width: 122, Height: 32, Right: 8);
      Padding: (Full: 2);

      $C.@TextField #HomesMaxHomesField {
        @Anchor = (Horizontal: 0, Height: 28, Vertical: 0);
      }
    }

    Group #HomesMaxHomesApplyBox {
      Anchor: (Width: 32, Height: 32);
      Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12);
      Visible: false;
      Button #HomesMaxHomesApply {
        Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0);
        Style: (
          Default: (Background: (TexturePath: "../icons/check.png", Color: #9bb4ce)),
          Hovered: (Background: (TexturePath: "../icons/check.png", Color: #ffffff)),
          Pressed: (Background: (TexturePath: "../icons/check.png", Color: #7f9cb9)),
          Disabled: (Background: (TexturePath: "../icons/check.png", Color: #5a6d80))
        );
      }
    }
  }

  Group #HomesGroupsManageRow {
    Anchor: (Height: 56, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Group {
        LayoutMode: Top;

        Label #HomesGroupsManageLabel {
          Anchor: (Horizontal: 0, Height: 20);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true);
          Text: "";
        }

        Label #HomesGroupsManageDescription {
          Anchor: (Horizontal: 0, Height: 16);
          Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
          Text: "";
        }
      }
    }

    TextButton #HomesManageGroupsButton {
      Anchor: (Width: 110, Height: 32);
      Text: "";
      Style: (
        Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Sounds: $Sounds.@ButtonsLight
      );
    }
  }

  Group {
    Anchor: (Horizontal: 0, Bottom: 4);
    LayoutMode: Top;

    Group {
      Anchor: (Horizontal: 0, Height: 1, Top: 10, Bottom: 14);
      Background: (Color: #3a465c);
    }

    Label #HomesPlayersSectionTitle {
      Anchor: (Horizontal: 0, Height: 26, Bottom: 4);
      Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
      Text: "Homes des joueurs";
    }
  }

  Group #HomesSearchRow {
    Anchor: (Height: 44, Horizontal: 0, Bottom: 6);
    LayoutMode: Left;
    Padding: (Left: 0, Right: 0, Top: 6, Bottom: 6);

    Group {
      FlexWeight: 1;
      Anchor: (Height: 32, Right: 8);

      $C.@TextField #HomesSearchField {
        @Anchor = (Horizontal: 0, Height: 32, Vertical: 0);
      }
    }

    TextButton #HomesSearchButton {
      Anchor: (Width: 96, Height: 32);
      Text: "Chercher";
      Style: (
        Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Sounds: $Sounds.@ButtonsLight
      );
    }
  }

  Group #HomesPlayerRow0 { Anchor: (Height: 52, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 12, Right: 10); Visible: false;
    Group { FlexWeight: 1; Anchor: (Vertical: 0, Right: 8); LayoutMode: Middle; Label #HomesPlayerName0 { Anchor: (Horizontal: 0, Height: 22, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true); Text: "Player"; } }
    Group #HomesPlayerValueFieldBorder0 { Anchor: (Width: 122, Height: 32, Right: 8); Padding: (Full: 2); $C.@TextField #HomesPlayerValueField0 { @Anchor = (Horizontal: 0, Height: 28, Vertical: 0); } }
    Group #HomesPlayerValueApplyBox0 { Anchor: (Width: 32, Height: 32, Right: 8); Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12); Visible: false; Button #HomesPlayerValueApply0 { Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0); Style: (Default: (Background: (TexturePath: "../icons/check.png", Color: #9bb4ce)), Hovered: (Background: (TexturePath: "../icons/check.png", Color: #ffffff)), Pressed: (Background: (TexturePath: "../icons/check.png", Color: #7f9cb9)), Disabled: (Background: (TexturePath: "../icons/check.png", Color: #5a6d80))); } }
    TextButton #HomesPlayerView0 { Anchor: (Width: 104, Height: 32); Text: "Voir homes"; Style: (Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Sounds: $Sounds.@ButtonsLight); }
  }
