          Group { Anchor: (Horizontal: 0, Height: 1, Top: 8, Bottom: 10); Background: (Color: #3a465c); }

          Group {
            Anchor: (Horizontal: 0, Bottom: 8);
            LayoutMode: Left;

            Group {
              FlexWeight: 1;
              LayoutMode: Top;

              Label #TeamCoopTitle {
                Anchor: (Horizontal: 0, Height: 22);
                Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #ffffff, RenderBold: true);
                Text: "Coop";
              }

              Label #TeamCoopDescription {
                Anchor: (Horizontal: 0, Height: 16, Top: 2);
                Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
                Text: "Manage coop access list.";
              }
            }

            Group { Anchor: (Width: 8); }

            $C.@SmallSecondaryTextButton #BtnCoopOpen {
              @Anchor = (Width: 150, Height: 32);
              Text: "Coop";
            }
          }

          Group #CoopTableHeader {
            Anchor: (Height: 30, Horizontal: 0, Bottom: 4);
            LayoutMode: Left;
            Background: (Color: #101925);
            Padding: (Left: 10, Right: 10);

