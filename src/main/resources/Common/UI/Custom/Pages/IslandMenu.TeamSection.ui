          Group #TeamMemberRow1 { Anchor: (Height: 34, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 10); Visible: false; Label #TeamMemberName1 { Anchor: (Width: 170, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Label #TeamMemberRole1 { Anchor: (Width: 55, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9fb2c2, VerticalAlignment: Center); Text: ""; } Group { FlexWeight: 1; } $C.@SmallSecondaryTextButton #BtnTeamPermissions1 { @Anchor = (Width: 100, Height: 28, Vertical: 0); Text: "Permissions"; } Group { Anchor: (Width: 6); } $C.@SmallSecondaryTextButton #BtnTeamKick1 { @Anchor = (Width: 90, Height: 28, Vertical: 0); Text: "Supprimer"; } Group { Anchor: (Width: 6); } $C.@SmallSecondaryTextButton #BtnTeamMakeLead1 { @Anchor = (Width: 108, Height: 28, Vertical: 0); Text: "Make lead"; } }
