$C = "../Common.ui";
$Sounds = "../Sounds.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 620, Height: 620);

  #Title {
    $C.@Title { @Text = ""; }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Full: 14);

    Label #HomesGroupsTitle {
      Anchor: (Horizontal: 0, Height: 24, Bottom: 4);
      Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #ffffff, RenderBold: true);
      Text: "";
    }

    Label #HomesGroupsDescription {
      Anchor: (Horizontal: 0, Height: 16, Bottom: 10);
      Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
      Text: "Configure les groupes (permissions iskyblock.homes.<group>).";
    }

    Label #HomesGroupsError {
      Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
      Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #ff5555, HorizontalAlignment: Center);
      Text: "";
      Visible: false;
    }

    Group {
      Anchor: (Height: 52, Horizontal: 0, Bottom: 8);
      LayoutMode: Left;
      Background: (Color: #182638);
      Padding: (Left: 12, Right: 10);

      Group {
        FlexWeight: 3;
        Anchor: (Height: 32, Right: 8);
        Padding: (Full: 2);
        $C.@TextField #HomesGroupCreateIdField { @Anchor = (Horizontal: 0, Height: 28, Vertical: 0); PlaceholderText: ""; }
      }

      Group {
        FlexWeight: 2;
        Anchor: (Height: 32, Right: 8);
        Padding: (Full: 2);
        $C.@TextField #HomesGroupCreateHomesField { @Anchor = (Horizontal: 0, Height: 28, Vertical: 0); PlaceholderText: ""; }
      }

      TextButton #HomesGroupCreateButton {
        Anchor: (Width: 96, Height: 32);
        Text: "Creer";
        Style: (
          Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Sounds: $Sounds.@ButtonsLight
        );
      }
    }

    Group #HomesGroupRow0 {
      Anchor: (Height: 56, Horizontal: 0, Bottom: 4);
      LayoutMode: Left;
      Background: (Color: #223149);
      Padding: (Left: 12, Right: 10);
      Visible: false;

      Group {
        FlexWeight: 1;
        Anchor: (Vertical: 0, Right: 8);
        LayoutMode: Middle;
        Group {
          Anchor: (Horizontal: 0, Height: 36);
          LayoutMode: Top;
          Label #HomesGroupName0 {
            Anchor: (Horizontal: 0, Height: 20);
            Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true);
            Text: "vip";
          }
          Label #HomesGroupPerm0 {
            Anchor: (Horizontal: 0, Height: 16);
            Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
            Text: "iskyblock.homes.vip";
          }
        }
      }

      Group #HomesGroupHomesFieldBorder0 { Anchor: (Width: 88, Height: 32, Right: 8); Padding: (Full: 2); $C.@TextField #HomesGroupHomesField0 { @Anchor = (Horizontal: 0, Height: 28, Vertical: 0); } }
      Group #HomesGroupApplyBox0 { Anchor: (Width: 32, Height: 32, Right: 8); Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12); Visible: false; Button #HomesGroupApply0 { Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0); Style: (Default: (Background: (TexturePath: "../icons/check.png", Color: #9bb4ce)), Hovered: (Background: (TexturePath: "../icons/check.png", Color: #ffffff)), Pressed: (Background: (TexturePath: "../icons/check.png", Color: #7f9cb9)), Disabled: (Background: (TexturePath: "../icons/check.png", Color: #5a6d80))); } }
      Group #HomesGroupDeleteBox0 { Anchor: (Width: 32, Height: 32); Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12); Button #HomesGroupDelete0 { Anchor: (Width: 16, Height: 16, Horizontal: 0, Vertical: 0); Style: (Default: (Background: (TexturePath: "../icons/trash.png", Color: #9bb4ce)), Hovered: (Background: (TexturePath: "../icons/trash.png", Color: #ffffff)), Pressed: (Background: (TexturePath: "../icons/trash.png", Color: #7f9cb9)), Disabled: (Background: (TexturePath: "../icons/trash.png", Color: #5a6d80))); } }
    }

