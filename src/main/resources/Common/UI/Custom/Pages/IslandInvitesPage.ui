$C = "../Common.ui";
$Sounds = "../Sounds.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 760, Height: 560);

  #Title {
    $C.@Title #InvitesTitle { @Text = "INVITATIONS"; }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Top: 16, Bottom: 16, Left: 18, Right: 18);

    Label #InvitesSubtitle {
      Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
      Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b2c1d0);
      Text: "";
    }

    Group {
      Anchor: (Horizontal: 0, Height: 34, Bottom: 8);
      LayoutMode: Left;

      $C.@TextField #InvitesSearchField {
        @Anchor = (Vertical: 0);
        FlexWeight: 1;
      }

      Group { Anchor: (Width: 8); }

      $C.@SmallSecondaryTextButton #BtnInvitesSearch {
        @Anchor = (Width: 120, Vertical: 0);
        Text: "Search";
      }
    }

    Label #InvitesCountLabel {
      Anchor: (Horizontal: 0, Height: 18, Bottom: 6);
      Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #cbd9e8);
      Text: "Invitations: 0";
    }

    Label #InvitesEmptyLabel {
      Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
      Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #d6a6a6);
      Text: "No pending invitations.";
      Visible: false;
    }

    Group {
      Anchor: (Horizontal: 0, Bottom: 10);
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;

      Group #InviteRow0 { Anchor: (Height: 34, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 10); Visible: false; Label #InviteName0 { Anchor: (Height: 18, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Group { Anchor: (Width: 8); } $C.@SmallSecondaryTextButton #BtnInviteAccept0 { @Anchor = (Width: 110, Height: 28); Text: "Accept"; } }
      Group #InviteRow1 { Anchor: (Height: 34, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 10); Visible: false; Label #InviteName1 { Anchor: (Height: 18, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Group { Anchor: (Width: 8); } $C.@SmallSecondaryTextButton #BtnInviteAccept1 { @Anchor = (Width: 110, Height: 28); Text: "Accept"; } }
      Group #InviteRow2 { Anchor: (Height: 34, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 10); Visible: false; Label #InviteName2 { Anchor: (Height: 18, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Group { Anchor: (Width: 8); } $C.@SmallSecondaryTextButton #BtnInviteAccept2 { @Anchor = (Width: 110, Height: 28); Text: "Accept"; } }
      Group #InviteRow3 { Anchor: (Height: 34, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 10); Visible: false; Label #InviteName3 { Anchor: (Height: 18, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Group { Anchor: (Width: 8); } $C.@SmallSecondaryTextButton #BtnInviteAccept3 { @Anchor = (Width: 110, Height: 28); Text: "Accept"; } }
      Group #InviteRow4 { Anchor: (Height: 34, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 10); Visible: false; Label #InviteName4 { Anchor: (Height: 18, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Group { Anchor: (Width: 8); } $C.@SmallSecondaryTextButton #BtnInviteAccept4 { @Anchor = (Width: 110, Height: 28); Text: "Accept"; } }
      Group #InviteRow5 { Anchor: (Height: 34, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 10); Visible: false; Label #InviteName5 { Anchor: (Height: 18, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Group { Anchor: (Width: 8); } $C.@SmallSecondaryTextButton #BtnInviteAccept5 { @Anchor = (Width: 110, Height: 28); Text: "Accept"; } }
      Group #InviteRow6 { Anchor: (Height: 34, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 10); Visible: false; Label #InviteName6 { Anchor: (Height: 18, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Group { Anchor: (Width: 8); } $C.@SmallSecondaryTextButton #BtnInviteAccept6 { @Anchor = (Width: 110, Height: 28); Text: "Accept"; } }
      Group #InviteRow7 { Anchor: (Height: 34, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 10); Visible: false; Label #InviteName7 { Anchor: (Height: 18, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Group { Anchor: (Width: 8); } $C.@SmallSecondaryTextButton #BtnInviteAccept7 { @Anchor = (Width: 110, Height: 28); Text: "Accept"; } }
      Group #InviteRow8 { Anchor: (Height: 34, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 10); Visible: false; Label #InviteName8 { Anchor: (Height: 18, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Group { Anchor: (Width: 8); } $C.@SmallSecondaryTextButton #BtnInviteAccept8 { @Anchor = (Width: 110, Height: 28); Text: "Accept"; } }
      Group #InviteRow9 { Anchor: (Height: 34, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 10, Right: 10); Visible: false; Label #InviteName9 { Anchor: (Height: 18, Vertical: 0); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } Group { Anchor: (Width: 8); } $C.@SmallSecondaryTextButton #BtnInviteAccept9 { @Anchor = (Width: 110, Height: 28); Text: "Accept"; } }
    }

    $C.@SecondaryTextButton #BtnInvitesBack {
      @Sounds = $Sounds.@ButtonsCancel;
      @Anchor = (Height: 36, Bottom: 4);
      Text: "Back";
    }
  }
}
