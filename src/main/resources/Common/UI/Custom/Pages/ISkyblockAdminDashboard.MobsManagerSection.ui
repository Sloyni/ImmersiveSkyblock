$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@MobsManagerSection = Group {
  LayoutMode: Top;
  Visible: false;

  Group {
    Anchor: (Horizontal: 0, Height: 1, Top: 10, Bottom: 14);
    Background: (Color: #3a465c);
  }

  Group {
    Anchor: (Horizontal: 0, Bottom: 12);
    LayoutMode: Left;

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #MobsManagerSectionTitle {
        Anchor: (Horizontal: 0, Height: 26, Bottom: 2);
        Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
        Text: "Mobs manager";
      }

      Label #MobsManagerSectionDescription {
        Anchor: (Horizontal: 0, Height: 18);
        Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
        Text: "Configure mob spawn reduction and torch protection.";
      }
    }
  }

  Group #MobsReduceMobsRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      Anchor: (Width: 34, Right: 10);
      LayoutMode: Middle;
      $C.@CheckBox #MobsReduceMobsToggle {
        @Anchor = (Width: 22, Height: 22, Vertical: 0);
        Value: false;
      }
    }

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #MobsReduceMobsLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Reduce mobs";
      }
    }
  }

  Group #MobsReduceRateRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #MobsReduceRateLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Reduce mobs rate (%)";
      }
    }

    SliderNumberField #MobsReduceRateField {
      Anchor: (Width: 200, Height: 5, Right: 0);
      SliderStyle: $C.@DefaultSliderStyle;
      NumberFieldStyle: $C.@DefaultInputFieldStyle;
      NumberFieldContainerAnchor: (Left: 10, Width: 42, Height: 15);
      Min: 0;
      Max: 100;
      Step: 1;
    }
  }

  Group #MobsTorchProtectionRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      Anchor: (Width: 34, Right: 10);
      LayoutMode: Middle;
      $C.@CheckBox #MobsTorchProtectionToggle {
        @Anchor = (Width: 22, Height: 22, Vertical: 0);
        Value: false;
      }
    }

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #MobsTorchProtectionLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Torch protection";
      }
    }
  }

  Group #MobsTorchRadiusRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #MobsTorchRadiusLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Torch protection radius";
      }
    }

    Group #MobsTorchRadiusFieldBorder {
      Anchor: (Width: 122, Height: 32, Right: 8);
      Padding: (Full: 2);

      $C.@TextField #MobsTorchRadiusField {
        @Anchor = (Horizontal: 0, Height: 28, Vertical: 0);
      }
    }

    Group #MobsTorchRadiusApplyBox {
      Anchor: (Width: 32, Height: 32);
      Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12);
      Visible: false;
      Button #MobsTorchRadiusApply {
        Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0);
        Style: (
          Default: (Background: (TexturePath: "../icons/check.png", Color: #9bb4ce)),
          Hovered: (Background: (TexturePath: "../icons/check.png", Color: #ffffff)),
          Pressed: (Background: (TexturePath: "../icons/check.png", Color: #7f9cb9)),
          Disabled: (Background: (TexturePath: "../icons/check.png", Color: #5a6d80))
        );
      }
    }
  }

  Label #MobsManagerError {
    Anchor: (Horizontal: 0, Height: 24, Top: 8);
    Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ff5555, HorizontalAlignment: Center);
    Text: "";
    Visible: false;
  }
};
