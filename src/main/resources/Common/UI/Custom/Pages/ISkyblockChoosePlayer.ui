        Group #PlayerRow13 { Anchor: (Height: 24, Bottom: 2); LayoutMode: Left; Label #PlayerName13 { Anchor: (Width: 560, Vertical: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff); Text: ""; } $C.@SmallSecondaryTextButton #SelectButton13 { @Anchor = (Width: 100, Height: 24); Text: "Select"; } }
        Group #PlayerRow14 { Anchor: (Height: 24, Bottom: 2); LayoutMode: Left; Label #PlayerName14 { Anchor: (Width: 560, Vertical: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff); Text: ""; } $C.@SmallSecondaryTextButton #SelectButton14 { @Anchor = (Width: 100, Height: 24); Text: "Select"; } }
