        Group #PlayerRow11 { Anchor: (Height: 24, Bottom: 2); LayoutMode: Left; Label #PlayerName11 { Anchor: (Width: 560, Vertical: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff); Text: ""; } $C.@SmallSecondaryTextButton #SelectButton11 { @Anchor = (Width: 100, Height: 24); Text: "Select"; } }
