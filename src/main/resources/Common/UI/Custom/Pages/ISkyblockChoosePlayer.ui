        Group #PlayerRow4 { Anchor: (Height: 24, Bottom: 2); LayoutMode: Left; Label #PlayerName4 { Anchor: (Width: 560, Vertical: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff); Text: ""; } $C.@SmallSecondaryTextButton #SelectButton4 { @Anchor = (Width: 100, Height: 24); Text: "Select"; } }
        Group #PlayerRow5 { Anchor: (Height: 24, Bottom: 2); LayoutMode: Left; Label #PlayerName5 { Anchor: (Width: 560, Vertical: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff); Text: ""; } $C.@SmallSecondaryTextButton #SelectButton5 { @Anchor = (Width: 100, Height: 24); Text: "Select"; } }
        Group #PlayerRow6 { Anchor: (Height: 24, Bottom: 2); LayoutMode: Left; Label #PlayerName6 { Anchor: (Width: 560, Vertical: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff); Text: ""; } $C.@SmallSecondaryTextButton #SelectButton6 { @Anchor = (Width: 100, Height: 24); Text: "Select"; } }
        Group #PlayerRow7 { Anchor: (Height: 24, Bottom: 2); LayoutMode: Left; Label #PlayerName7 { Anchor: (Width: 560, Vertical: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff); Text: ""; } $C.@SmallSecondaryTextButton #SelectButton7 { @Anchor = (Width: 100, Height: 24); Text: "Select"; } }
        Group #PlayerRow8 { Anchor: (Height: 24, Bottom: 2); LayoutMode: Left; Label #PlayerName8 { Anchor: (Width: 560, Vertical: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff); Text: ""; } $C.@SmallSecondaryTextButton #SelectButton8 { @Anchor = (Width: 100, Height: 24); Text: "Select"; } }
        Group #PlayerRow9 { Anchor: (Height: 24, Bottom: 2); LayoutMode: Left; Label #PlayerName9 { Anchor: (Width: 560, Vertical: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff); Text: ""; } $C.@SmallSecondaryTextButton #SelectButton9 { @Anchor = (Width: 100, Height: 24); Text: "Select"; } }
