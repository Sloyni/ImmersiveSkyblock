$C = "../Common.ui";
$Sounds = "../Sounds.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 780, Height: 680);

    #Title {
      $C.@Title {
        @Text = "";
      }

      Label #PageTitle {
        Style: (...$C.@DefaultLabelStyle, FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center);
        Anchor: (Height: 30);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #Subtitle {
        Anchor: (Height: 28, Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b2c1d0, Wrap: true);
        Text: "";
      }

      TextField #SearchInput {
        Anchor: (Height: 34, Bottom: 8);
      }

      Label #CountLabel {
        Anchor: (Height: 22, Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #cbd9e8);
        Text: "Players: 0";
      }

      Label #EmptyLabel {
        Anchor: (Height: 22, Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #d6a6a6);
        Text: "No players found.";
        Visible: false;
      }

      Group {
        Anchor: (Height: 500, Bottom: 8);
        LayoutMode: Top;

        Group #PlayerRow0 { Anchor: (Height: 24, Bottom: 2); LayoutMode: Left; Label #PlayerName0 { Anchor: (Width: 560, Vertical: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff); Text: ""; } $C.@SmallSecondaryTextButton #SelectButton0 { @Anchor = (Width: 100, Height: 24); Text: "Select"; } }
        Group #PlayerRow1 { Anchor: (Height: 24, Bottom: 2); LayoutMode: Left; Label #PlayerName1 { Anchor: (Width: 560, Vertical: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff); Text: ""; } $C.@SmallSecondaryTextButton #SelectButton1 { @Anchor = (Width: 100, Height: 24); Text: "Select"; } }
