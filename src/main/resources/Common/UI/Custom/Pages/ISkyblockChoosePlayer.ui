        Group #PlayerRow16 { Anchor: (Height: 24, Bottom: 2); LayoutMode: Left; Label #PlayerName16 { Anchor: (Width: 560, Vertical: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff); Text: ""; } $C.@SmallSecondaryTextButton #SelectButton16 { @Anchor = (Width: 100, Height: 24); Text: "Select"; } }
        Group #PlayerRow17 { Anchor: (Height: 24, Bottom: 2); LayoutMode: Left; Label #PlayerName17 { Anchor: (Width: 560, Vertical: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff); Text: ""; } $C.@SmallSecondaryTextButton #SelectButton17 { @Anchor = (Width: 100, Height: 24); Text: "Select"; } }
        Group #PlayerRow18 { Anchor: (Height: 24, Bottom: 2); LayoutMode: Left; Label #PlayerName18 { Anchor: (Width: 560, Vertical: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff); Text: ""; } $C.@SmallSecondaryTextButton #SelectButton18 { @Anchor = (Width: 100, Height: 24); Text: "Select"; } }
        Group #PlayerRow19 { Anchor: (Height: 24, Bottom: 2); LayoutMode: Left; Label #PlayerName19 { Anchor: (Width: 560, Vertical: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff); Text: ""; } $C.@SmallSecondaryTextButton #SelectButton19 { @Anchor = (Width: 100, Height: 24); Text: "Select"; } }
      }

      $C.@SecondaryTextButton #BackButton {
        @Sounds = $Sounds.@ButtonsCancel;
        @Anchor = (Height: 40);
        Text: "Back";
      }
    }
  }
}
