$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@ResetsSection = Group {
  LayoutMode: Top;
  Visible: false;

  Group #ResetsTopDivider {
    Anchor: (Horizontal: 0, Height: 1, Top: 10, Bottom: 14);
    Background: (Color: #3a465c);
  }

  Group {
    Anchor: (Horizontal: 0, Bottom: 12);
    LayoutMode: Left;

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #ResetsSectionTitle {
        Anchor: (Horizontal: 0, Height: 26, Bottom: 2);
        Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
        Text: "Resets";
      }

      Label #ResetsSectionDescription {
        Anchor: (Horizontal: 0, Height: 18);
        Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
        Text: "Manage global max resets and per-player reset values.";
      }
    }
  }

  Group #ResetsMaxResetsRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #ResetsMaxResetsLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Default max resets";
      }
    }

    Group #ResetsMaxResetsFieldBorder {
      Anchor: (Width: 122, Height: 32, Right: 8);
      Padding: (Full: 2);

      $C.@TextField #ResetsMaxResetsField {
        @Anchor = (Horizontal: 0, Height: 28, Vertical: 0);
      }
    }

    Group #ResetsMaxResetsApplyBox {
      Anchor: (Width: 32, Height: 32);
      Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12);
      Visible: false;
      Button #ResetsMaxResetsApply {
        Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0);
        Style: (
          Default: (Background: (TexturePath: "../icons/check.png", Color: #9bb4ce)),
          Hovered: (Background: (TexturePath: "../icons/check.png", Color: #ffffff)),
          Pressed: (Background: (TexturePath: "../icons/check.png", Color: #7f9cb9)),
          Disabled: (Background: (TexturePath: "../icons/check.png", Color: #5a6d80))
        );
      }
    }
  }

  Group {
    Anchor: (Horizontal: 0, Bottom: 4);
    LayoutMode: Top;

    Group {
      Anchor: (Horizontal: 0, Height: 1, Top: 14, Bottom: 10);
      Background: (Color: #3a465c);
    }

    Label #ResetsPlayersSectionTitle {
      Anchor: (Horizontal: 0, Height: 26, Bottom: 4);
      Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
      Text: "Resets des joueurs";
    }
  }

  Group #ResetsSearchRow {
    Anchor: (Height: 44, Horizontal: 0, Bottom: 6);
    LayoutMode: Left;
    Padding: (Left: 0, Right: 0, Top: 6, Bottom: 6);

    Group {
      FlexWeight: 1;
      Anchor: (Height: 32, Right: 8);

      $C.@TextField #ResetsSearchField {
        @Anchor = (Horizontal: 0, Height: 32, Vertical: 0);
      }
    }

    TextButton #ResetsSearchButton {
      Anchor: (Width: 96, Height: 32);
      Text: "Chercher";
      Style: (
        Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Sounds: $Sounds.@ButtonsLight
      );
    }
  }

  Group #ResetsPlayerRow0 {
    Anchor: (Height: 52, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);
    Visible: false;

    Label #ResetsPlayerName0 {
      Anchor: (Height: 22, Vertical: 0, Right: 8);
      FlexWeight: 1;
      Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
      Text: "Player";
    }

    Group #ResetsPlayerValueFieldBorder0 {
      Anchor: (Width: 122, Height: 32, Right: 8);
      Padding: (Full: 2);

      $C.@TextField #ResetsPlayerValueField0 {
        @Anchor = (Horizontal: 0, Height: 28, Vertical: 0);
      }
    }

    Group #ResetsPlayerValueApplyBox0 {
      Anchor: (Width: 32, Height: 32);
      Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12);
      Visible: false;
      Button #ResetsPlayerValueApply0 {
        Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0);
        Style: (
          Default: (Background: (TexturePath: "../icons/check.png", Color: #9bb4ce)),
          Hovered: (Background: (TexturePath: "../icons/check.png", Color: #ffffff)),
          Pressed: (Background: (TexturePath: "../icons/check.png", Color: #7f9cb9)),
          Disabled: (Background: (TexturePath: "../icons/check.png", Color: #5a6d80))
        );
      }
    }
  }

