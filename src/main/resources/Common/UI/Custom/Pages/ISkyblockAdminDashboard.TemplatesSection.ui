$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@TemplatesSection = Group {
        LayoutMode: Top;

        Group {
          Anchor: (Horizontal: 0, Height: 1, Top: 10, Bottom: 14);
          Background: (Color: #3a465c);
        }

        Group {
          Anchor: (Horizontal: 0, Bottom: 12);
          LayoutMode: Left;
          Group {
            FlexWeight: 1;
            LayoutMode: Top;

            Label #TemplatesSectionTitle {
              Anchor: (Horizontal: 0, Height: 26, Bottom: 2);
              Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
              Text: "Templates disponibles";
            }

            Label #TemplatesSectionDescription {
              Anchor: (Horizontal: 0, Height: 18);
              Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
              Text: "Activez, ordonnez, modifiez ou supprimez les templates existants.";
            }
          }

          Group {
            Anchor: (Width: 32, Height: 32, Top: 2);
            Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12);
            Button #RefreshTemplates { Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0);
              Style: (
                Default: (Background: (TexturePath: "../icons/reload.png", Color: #9bb4ce)),
                Hovered: (Background: (TexturePath: "../icons/reload.png", Color: #ffffff)),
                Pressed: (Background: (TexturePath: "../icons/reload.png", Color: #7f9cb9)),
                Disabled: (Background: (TexturePath: "../icons/reload.png", Color: #5a6d80))
              );
            }
          }
        }

      // === Template rows ===
      Group #TplRow0 { Anchor: (Height: 60, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 12, Right: 10); Visible: false;
        Group {
          Anchor: (Width: 34, Right: 10);
          LayoutMode: Middle;
          $C.@CheckBox #TplEnabled0 { @Anchor = (Width: 22, Height: 22, Vertical: 0); Value: false; Visible: false; }
        }
        Group { FlexWeight: 1; Anchor: (Vertical: 0); LayoutMode: Top; Padding: (Top: 8);
          Label #TplName0 { Anchor: (Horizontal: 0, Height: 22, Top: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true); Text: ""; }
          Label #TplSubId0 { Anchor: (Horizontal: 0, Height: 14); Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8e9e, VerticalAlignment: Center); Text: ""; }
        }
        Group #TplUpBox0 {
        Anchor: (Width: 32, Height: 32, Right: 6);
        Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12);
        Visible: false;
        Button #TplUp0 { Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0); Style: (Default: (Background: (TexturePath: "../icons/chevron-top.png", Color: #9bb4ce)), Hovered: (Background: (TexturePath: "../icons/chevron-top.png", Color: #ffffff)), Pressed: (Background: (TexturePath: "../icons/chevron-top.png", Color: #7f9cb9)), Disabled: (Background: (TexturePath: "../icons/chevron-top.png", Color: #5a6d80))); Visible: false; }
      }
        Group #TplDownBox0 {
        Anchor: (Width: 32, Height: 32, Right: 6);
        Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12);
        Visible: false;
        Button #TplDown0 { Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0); Style: (Default: (Background: (TexturePath: "../icons/chevron-bottom.png", Color: #9bb4ce)), Hovered: (Background: (TexturePath: "../icons/chevron-bottom.png", Color: #ffffff)), Pressed: (Background: (TexturePath: "../icons/chevron-bottom.png", Color: #7f9cb9)), Disabled: (Background: (TexturePath: "../icons/chevron-bottom.png", Color: #5a6d80))); Visible: false; }
      }
        Group #TplEditBox0 {
        Anchor: (Width: 32, Height: 32, Right: 6);
        Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12);
        Visible: false;
        Button #TplEdit0 { Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0); Style: (Default: (Background: (TexturePath: "../icons/pen.png", Color: #9bb4ce)), Hovered: (Background: (TexturePath: "../icons/pen.png", Color: #ffffff)), Pressed: (Background: (TexturePath: "../icons/pen.png", Color: #7f9cb9)), Disabled: (Background: (TexturePath: "../icons/pen.png", Color: #5a6d80))); Visible: false; }
      }
        Group #TplDeleteBox0 {
        Anchor: (Width: 32, Height: 32, Right: 6);
        Background: (TexturePath: "../Common/Buttons/Destructive.png", Border: 12);
        Visible: false;
        Button #TplDelete0 { Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0); Style: (Default: (Background: (TexturePath: "../icons/trash.png", Color: #d4a4a4)), Hovered: (Background: (TexturePath: "../icons/trash.png", Color: #ffcccc)), Pressed: (Background: (TexturePath: "../icons/trash.png", Color: #b78989)), Disabled: (Background: (TexturePath: "../icons/trash.png", Color: #725959))); Visible: false; }
      }
        Label #TplError0 { Anchor: (Width: 540, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ff8080, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: Center); Text: "Erreur"; Visible: false; }
