        Button #TplDelete19 { Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0); Style: (Default: (Background: (TexturePath: "../icons/trash.png", Color: #d4a4a4)), Hovered: (Background: (TexturePath: "../icons/trash.png", Color: #ffcccc)), Pressed: (Background: (TexturePath: "../icons/trash.png", Color: #b78989)), Disabled: (Background: (TexturePath: "../icons/trash.png", Color: #725959))); Visible: false; }
      }
        Label #TplError19 { Anchor: (Width: 540, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ff8080, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: Center); Text: "Erreur"; Visible: false; }
      }
      
};
