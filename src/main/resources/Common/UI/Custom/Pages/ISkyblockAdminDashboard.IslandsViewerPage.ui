$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@SecondaryTextButtonStyle = TextButtonStyle(
  Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $Sounds.@ButtonsLight
);

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 820, Height: 700);

  #Title {
    $C.@Title { @Text = "Island Controls"; }
  }

  #Content {
    LayoutMode: TopScrolling;
    Padding: (Top: 14, Bottom: 14, Left: 22, Right: 22);
    ScrollbarStyle: $C.@DefaultScrollbarStyle;

    Label #IslandsViewerTitle {
      Anchor: (Horizontal: 0, Height: 24, Bottom: 4);
      Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #ffffff, RenderBold: true);
      Text: "Island";
    }

    Label #IslandsViewerDescription {
      Anchor: (Horizontal: 0, Height: 16, Bottom: 8);
      Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
      Text: "";
    }

    Label #IslandsViewerSuccess {
      Anchor: (Horizontal: 0, Height: 18, Bottom: 4);
      Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #8fdaa8);
      Text: "";
      Visible: false;
    }

    Label #IslandsViewerError {
      Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
      Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ff7a7a);
      Text: "";
      Visible: false;
    }

    Group #IslandsViewerSections {
      Anchor: (Horizontal: 0);
      LayoutMode: Top;
      Visible: true;

      Group {
        Anchor: (Horizontal: 0, Height: 1, Bottom: 14);
        Background: (Color: #3a465c);
      }

      Group {
        Anchor: (Horizontal: 0, Bottom: 14);
        LayoutMode: Left;

        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          Label #IslandsOverviewTitle {
            Anchor: (Horizontal: 0, Height: 24, Bottom: 2);
            Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #ffffff, RenderBold: true);
            Text: "Overview";
          }

          Label #IslandsOverviewDescription {
            Anchor: (Horizontal: 0, Height: 16);
            Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
            Text: "";
          }
        }

        TextButton #IslandsViewerTeleportButton {
          Anchor: (Height: 32, Right: 10);
          Padding: (Horizontal: 16);
          Text: "Teleport";
          Style: @SecondaryTextButtonStyle;
        }

        TextButton #IslandsViewerLockButton {
          Anchor: (Height: 32);
          Padding: (Horizontal: 16);
          Text: "Lock";
          Style: @SecondaryTextButtonStyle;
        }
      }

      Group #IslandsInfoRowPlayer { Anchor: (Height: 42, Horizontal: 0, Bottom: 3); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 12, Right: 12); Label #IslandsInfoPlayerLabel { Anchor: (Width: 140, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9bb4ce, RenderBold: true, VerticalAlignment: Center); Text: "Player"; } Label #IslandsInfoPlayerValue { Anchor: (Horizontal: 0, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } }
      Group #IslandsInfoRowIsland { Anchor: (Height: 42, Horizontal: 0, Bottom: 3); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 12, Right: 12); Label #IslandsInfoIslandLabel { Anchor: (Width: 140, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9bb4ce, RenderBold: true, VerticalAlignment: Center); Text: "Island"; } Label #IslandsInfoIslandValue { Anchor: (Horizontal: 0, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } }
      Group #IslandsInfoRowLeader { Anchor: (Height: 42, Horizontal: 0, Bottom: 3); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 12, Right: 12); Label #IslandsInfoLeaderLabel { Anchor: (Width: 140, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9bb4ce, RenderBold: true, VerticalAlignment: Center); Text: "Leader"; } Label #IslandsInfoLeaderValue { Anchor: (Horizontal: 0, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } }
      Group #IslandsInfoRowTemplate { Anchor: (Height: 42, Horizontal: 0, Bottom: 3); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 12, Right: 12); Label #IslandsInfoTemplateLabel { Anchor: (Width: 140, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9bb4ce, RenderBold: true, VerticalAlignment: Center); Text: "Template"; } Label #IslandsInfoTemplateValue { Anchor: (Horizontal: 0, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } }
      Group #IslandsInfoRowWorld { Anchor: (Height: 42, Horizontal: 0, Bottom: 3); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 12, Right: 12); Label #IslandsInfoWorldLabel { Anchor: (Width: 140, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9bb4ce, RenderBold: true, VerticalAlignment: Center); Text: "World"; } Label #IslandsInfoWorldValue { Anchor: (Horizontal: 0, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } }
      Group #IslandsInfoRowGrid { Anchor: (Height: 42, Horizontal: 0, Bottom: 3); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 12, Right: 12); Label #IslandsInfoGridLabel { Anchor: (Width: 140, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9bb4ce, RenderBold: true, VerticalAlignment: Center); Text: "Grid"; } Label #IslandsInfoGridValue { Anchor: (Horizontal: 0, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } }
      Group #IslandsInfoRowCenter { Anchor: (Height: 42, Horizontal: 0, Bottom: 3); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 12, Right: 12); Label #IslandsInfoCenterLabel { Anchor: (Width: 140, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9bb4ce, RenderBold: true, VerticalAlignment: Center); Text: "Center"; } Label #IslandsInfoCenterValue { Anchor: (Horizontal: 0, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } }
      Group #IslandsInfoRowState { Anchor: (Height: 42, Horizontal: 0, Bottom: 10); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 12, Right: 12); Label #IslandsInfoStateLabel { Anchor: (Width: 140, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9bb4ce, RenderBold: true, VerticalAlignment: Center); Text: "State"; } Label #IslandsInfoStateValue { Anchor: (Horizontal: 0, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; } }

      Group {
        Anchor: (Horizontal: 0, Height: 1, Top: 6, Bottom: 12);
        Background: (Color: #3a465c);
      }

      Label #IslandsNameSectionTitle {
        Anchor: (Horizontal: 0, Height: 22, Bottom: 2);
        Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #ffffff, RenderBold: true);
        Text: "Name";
      }

      Label #IslandsNameSectionDescription {
        Anchor: (Horizontal: 0, Height: 16, Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
        Text: "";
      }

      Group #IslandsNameRow {
        Anchor: (Height: 56, Horizontal: 0, Bottom: 14);
        LayoutMode: Left;
        Background: (Color: #223149);
        Padding: (Left: 16, Right: 16);

        Label #IslandsNameLabel {
          Anchor: (Width: 120, Height: 18, Right: 10);
          Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
          Text: "Island name";
        }

        Group #IslandsNameFieldBorder {
          FlexWeight: 1;
          Anchor: (Height: 32, Right: 10);
          Padding: (Full: 2);

          $C.@TextField #IslandsNameField {
            @Anchor = (Horizontal: 0, Height: 28);
          }
        }

        Group #IslandsNameApplyBox {
          Anchor: (Width: 32, Height: 32, Right: 10);
          Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12);
          Visible: false;
          Button #IslandsNameApply {
            Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0);
            Style: (
              Default: (Background: (TexturePath: "../icons/check.png", Color: #9bb4ce)),
              Hovered: (Background: (TexturePath: "../icons/check.png", Color: #ffffff)),
              Pressed: (Background: (TexturePath: "../icons/check.png", Color: #7f9cb9)),
              Disabled: (Background: (TexturePath: "../icons/check.png", Color: #5a6d80))
            );
          }
        }

        TextButton #IslandsNameResetButton {
          Anchor: (Height: 32);
          Padding: (Horizontal: 16);
          Text: "Reset";
          Style: @SecondaryTextButtonStyle;
        }
      }

      Group {
        Anchor: (Horizontal: 0, Height: 1, Top: 6, Bottom: 12);
        Background: (Color: #3a465c);
      }

      Label #IslandsSizeSectionTitle {
        Anchor: (Horizontal: 0, Height: 22, Bottom: 2);
        Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #ffffff, RenderBold: true);
        Text: "Size";
      }

      Label #IslandsSizeSectionDescription {
        Anchor: (Horizontal: 0, Height: 16, Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
        Text: "";
      }

      Group #IslandsSizeRow {
        Anchor: (Height: 56, Horizontal: 0, Bottom: 14);
        LayoutMode: Left;
        Background: (Color: #223149);
        Padding: (Left: 16, Right: 16);

        Group {
          FlexWeight: 1;
          Anchor: (Right: 10, Height: 34, Vertical: 0);
          LayoutMode: Top;

          Label #IslandsSizeLabel {
            Anchor: (Horizontal: 0, Height: 18);
            Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true);
            Text: "Island size";
          }

          Label #IslandsSizeHint {
            Anchor: (Horizontal: 0, Height: 16);
            Style: (...$C.@DefaultLabelStyle, FontSize: 10, TextColor: #7f8fa3);
            Text: "";
          }
        }

        Group #IslandsSizeFieldBorder {
          Anchor: (Width: 130, Height: 32, Right: 10);
          Padding: (Full: 2);

          $C.@TextField #IslandsSizeField {
            @Anchor = (Horizontal: 0, Height: 28);
          }
        }

        Group #IslandsSizeApplyBox {
          Anchor: (Width: 32, Height: 32);
          Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12);
          Visible: false;
          Button #IslandsSizeApply {
            Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0);
            Style: (
              Default: (Background: (TexturePath: "../icons/check.png", Color: #9bb4ce)),
              Hovered: (Background: (TexturePath: "../icons/check.png", Color: #ffffff)),
              Pressed: (Background: (TexturePath: "../icons/check.png", Color: #7f9cb9)),
              Disabled: (Background: (TexturePath: "../icons/check.png", Color: #5a6d80))
            );
          }
        }
      }

      Group {
        Anchor: (Horizontal: 0, Height: 1, Top: 6, Bottom: 12);
        Background: (Color: #3a465c);
      }

      Label #IslandsTeamSectionTitle { Anchor: (Horizontal: 0, Height: 22, Bottom: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #ffffff, RenderBold: true); Text: "Team"; }
      Label #IslandsTeamSectionDescription { Anchor: (Horizontal: 0, Height: 16, Bottom: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3); Text: ""; }
      Group #IslandsTeamInputRow { Anchor: (Height: 44, Horizontal: 0, Bottom: 4); LayoutMode: Left; Padding: (Top: 6, Bottom: 6);
        Group { FlexWeight: 1; Anchor: (Height: 32, Right: 10); $C.@TextField #IslandsTeamField { @Anchor = (Horizontal: 0, Height: 32); } }
        TextButton #IslandsTeamAddButton { Anchor: (Height: 32); Padding: (Horizontal: 16); Text: "Add"; Style: @SecondaryTextButtonStyle; }
      }
      Group #IslandsTeamRow0 { Anchor: (Height: 40, Horizontal: 0, Bottom: 3); Background: (Color: #223149); LayoutMode: Left; Padding: (Left: 10, Right: 10); Visible: false; Label #IslandsTeamName0 { Anchor: (Height: 18, Vertical: 0, Right: 10); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); Text: "Member"; } TextButton #IslandsTeamLeaderRowButton0 { Anchor: (Height: 28, Right: 8); Padding: (Horizontal: 12); Text: "Leader"; Style: @SecondaryTextButtonStyle; Visible: false; } TextButton #IslandsTeamRemoveRowButton0 { Anchor: (Height: 28); Padding: (Horizontal: 12); Text: "Remove"; Style: @SecondaryTextButtonStyle; Visible: false; } }
      Group #IslandsTeamRow1 { Anchor: (Height: 40, Horizontal: 0, Bottom: 3); Background: (Color: #223149); LayoutMode: Left; Padding: (Left: 10, Right: 10); Visible: false; Label #IslandsTeamName1 { Anchor: (Height: 18, Vertical: 0, Right: 10); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); Text: "Member"; } TextButton #IslandsTeamLeaderRowButton1 { Anchor: (Height: 28, Right: 8); Padding: (Horizontal: 12); Text: "Leader"; Style: @SecondaryTextButtonStyle; Visible: false; } TextButton #IslandsTeamRemoveRowButton1 { Anchor: (Height: 28); Padding: (Horizontal: 12); Text: "Remove"; Style: @SecondaryTextButtonStyle; Visible: false; } }
      Group #IslandsTeamRow2 { Anchor: (Height: 40, Horizontal: 0, Bottom: 3); Background: (Color: #223149); LayoutMode: Left; Padding: (Left: 10, Right: 10); Visible: false; Label #IslandsTeamName2 { Anchor: (Height: 18, Vertical: 0, Right: 10); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); Text: "Member"; } TextButton #IslandsTeamLeaderRowButton2 { Anchor: (Height: 28, Right: 8); Padding: (Horizontal: 12); Text: "Leader"; Style: @SecondaryTextButtonStyle; Visible: false; } TextButton #IslandsTeamRemoveRowButton2 { Anchor: (Height: 28); Padding: (Horizontal: 12); Text: "Remove"; Style: @SecondaryTextButtonStyle; Visible: false; } }
      Group #IslandsTeamRow3 { Anchor: (Height: 40, Horizontal: 0, Bottom: 3); Background: (Color: #223149); LayoutMode: Left; Padding: (Left: 10, Right: 10); Visible: false; Label #IslandsTeamName3 { Anchor: (Height: 18, Vertical: 0, Right: 10); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); Text: "Member"; } TextButton #IslandsTeamLeaderRowButton3 { Anchor: (Height: 28, Right: 8); Padding: (Horizontal: 12); Text: "Leader"; Style: @SecondaryTextButtonStyle; Visible: false; } TextButton #IslandsTeamRemoveRowButton3 { Anchor: (Height: 28); Padding: (Horizontal: 12); Text: "Remove"; Style: @SecondaryTextButtonStyle; Visible: false; } }
      Group #IslandsTeamRow4 { Anchor: (Height: 40, Horizontal: 0, Bottom: 14); Background: (Color: #223149); LayoutMode: Left; Padding: (Left: 10, Right: 10); Visible: false; Label #IslandsTeamName4 { Anchor: (Height: 18, Vertical: 0, Right: 10); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); Text: "Member"; } TextButton #IslandsTeamLeaderRowButton4 { Anchor: (Height: 28, Right: 8); Padding: (Horizontal: 12); Text: "Leader"; Style: @SecondaryTextButtonStyle; Visible: false; } TextButton #IslandsTeamRemoveRowButton4 { Anchor: (Height: 28); Padding: (Horizontal: 12); Text: "Remove"; Style: @SecondaryTextButtonStyle; Visible: false; } }

      Group {
        Anchor: (Horizontal: 0, Height: 1, Top: 6, Bottom: 12);
        Background: (Color: #3a465c);
      }

      Label #IslandsCoopSectionTitle { Anchor: (Horizontal: 0, Height: 22, Bottom: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #ffffff, RenderBold: true); Text: "Coop"; }
      Label #IslandsCoopSectionDescription { Anchor: (Horizontal: 0, Height: 16, Bottom: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3); Text: ""; }

      Group #IslandsCoopInputRow { Anchor: (Height: 44, Horizontal: 0, Bottom: 4); LayoutMode: Left; Padding: (Top: 6, Bottom: 6);
        Group { FlexWeight: 1; Anchor: (Height: 32, Right: 10); $C.@TextField #IslandsCoopField { @Anchor = (Horizontal: 0, Height: 32); } }
        TextButton #IslandsCoopAddButton { Anchor: (Height: 32); Padding: (Horizontal: 16); Text: "Add"; Style: @SecondaryTextButtonStyle; }
      }
      Group #IslandsCoopRow0 { Anchor: (Height: 40, Horizontal: 0, Bottom: 3); Background: (Color: #223149); LayoutMode: Left; Padding: (Left: 10, Right: 10); Visible: false; Label #IslandsCoopName0 { Anchor: (Height: 18, Vertical: 0, Right: 10); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); Text: "Coop"; } TextButton #IslandsCoopRemoveRowButton0 { Anchor: (Height: 28); Padding: (Horizontal: 12); Text: "Remove"; Style: @SecondaryTextButtonStyle; Visible: false; } }
      Group #IslandsCoopRow1 { Anchor: (Height: 40, Horizontal: 0, Bottom: 3); Background: (Color: #223149); LayoutMode: Left; Padding: (Left: 10, Right: 10); Visible: false; Label #IslandsCoopName1 { Anchor: (Height: 18, Vertical: 0, Right: 10); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); Text: "Coop"; } TextButton #IslandsCoopRemoveRowButton1 { Anchor: (Height: 28); Padding: (Horizontal: 12); Text: "Remove"; Style: @SecondaryTextButtonStyle; Visible: false; } }
      Group #IslandsCoopRow2 { Anchor: (Height: 40, Horizontal: 0, Bottom: 3); Background: (Color: #223149); LayoutMode: Left; Padding: (Left: 10, Right: 10); Visible: false; Label #IslandsCoopName2 { Anchor: (Height: 18, Vertical: 0, Right: 10); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); Text: "Coop"; } TextButton #IslandsCoopRemoveRowButton2 { Anchor: (Height: 28); Padding: (Horizontal: 12); Text: "Remove"; Style: @SecondaryTextButtonStyle; Visible: false; } }
      Group #IslandsCoopRow3 { Anchor: (Height: 40, Horizontal: 0, Bottom: 3); Background: (Color: #223149); LayoutMode: Left; Padding: (Left: 10, Right: 10); Visible: false; Label #IslandsCoopName3 { Anchor: (Height: 18, Vertical: 0, Right: 10); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); Text: "Coop"; } TextButton #IslandsCoopRemoveRowButton3 { Anchor: (Height: 28); Padding: (Horizontal: 12); Text: "Remove"; Style: @SecondaryTextButtonStyle; Visible: false; } }
      Group #IslandsCoopRow4 { Anchor: (Height: 40, Horizontal: 0, Bottom: 14); Background: (Color: #223149); LayoutMode: Left; Padding: (Left: 10, Right: 10); Visible: false; Label #IslandsCoopName4 { Anchor: (Height: 18, Vertical: 0, Right: 10); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); Text: "Coop"; } TextButton #IslandsCoopRemoveRowButton4 { Anchor: (Height: 28); Padding: (Horizontal: 12); Text: "Remove"; Style: @SecondaryTextButtonStyle; Visible: false; } }

      Group {
        Anchor: (Horizontal: 0, Height: 1, Top: 6, Bottom: 12);
        Background: (Color: #3a465c);
      }

      Label #IslandsBanSectionTitle { Anchor: (Horizontal: 0, Height: 22, Bottom: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #ffffff, RenderBold: true); Text: "Bans"; }
      Label #IslandsBanSectionDescription { Anchor: (Horizontal: 0, Height: 16, Bottom: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3); Text: ""; }

      Group #IslandsBanInputRow { Anchor: (Height: 44, Horizontal: 0, Bottom: 4); LayoutMode: Left; Padding: (Top: 6, Bottom: 6);
        Group { FlexWeight: 1; Anchor: (Height: 32, Right: 10); $C.@TextField #IslandsBanField { @Anchor = (Horizontal: 0, Height: 32); } }
        TextButton #IslandsBanAddButton { Anchor: (Height: 32); Padding: (Horizontal: 16); Text: "Ban"; Style: @SecondaryTextButtonStyle; }
      }
      Group #IslandsBanRow0 { Anchor: (Height: 40, Horizontal: 0, Bottom: 3); Background: (Color: #223149); LayoutMode: Left; Padding: (Left: 10, Right: 10); Visible: false; Label #IslandsBanName0 { Anchor: (Height: 18, Vertical: 0, Right: 10); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); Text: "Banned"; } TextButton #IslandsBanRemoveRowButton0 { Anchor: (Height: 28); Padding: (Horizontal: 12); Text: "Unban"; Style: @SecondaryTextButtonStyle; Visible: false; } }
      Group #IslandsBanRow1 { Anchor: (Height: 40, Horizontal: 0, Bottom: 3); Background: (Color: #223149); LayoutMode: Left; Padding: (Left: 10, Right: 10); Visible: false; Label #IslandsBanName1 { Anchor: (Height: 18, Vertical: 0, Right: 10); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); Text: "Banned"; } TextButton #IslandsBanRemoveRowButton1 { Anchor: (Height: 28); Padding: (Horizontal: 12); Text: "Unban"; Style: @SecondaryTextButtonStyle; Visible: false; } }
      Group #IslandsBanRow2 { Anchor: (Height: 40, Horizontal: 0, Bottom: 3); Background: (Color: #223149); LayoutMode: Left; Padding: (Left: 10, Right: 10); Visible: false; Label #IslandsBanName2 { Anchor: (Height: 18, Vertical: 0, Right: 10); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); Text: "Banned"; } TextButton #IslandsBanRemoveRowButton2 { Anchor: (Height: 28); Padding: (Horizontal: 12); Text: "Unban"; Style: @SecondaryTextButtonStyle; Visible: false; } }
      Group #IslandsBanRow3 { Anchor: (Height: 40, Horizontal: 0, Bottom: 3); Background: (Color: #223149); LayoutMode: Left; Padding: (Left: 10, Right: 10); Visible: false; Label #IslandsBanName3 { Anchor: (Height: 18, Vertical: 0, Right: 10); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); Text: "Banned"; } TextButton #IslandsBanRemoveRowButton3 { Anchor: (Height: 28); Padding: (Horizontal: 12); Text: "Unban"; Style: @SecondaryTextButtonStyle; Visible: false; } }
      Group #IslandsBanRow4 { Anchor: (Height: 40, Horizontal: 0, Bottom: 14); Background: (Color: #223149); LayoutMode: Left; Padding: (Left: 10, Right: 10); Visible: false; Label #IslandsBanName4 { Anchor: (Height: 18, Vertical: 0, Right: 10); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); Text: "Banned"; } TextButton #IslandsBanRemoveRowButton4 { Anchor: (Height: 28); Padding: (Horizontal: 12); Text: "Unban"; Style: @SecondaryTextButtonStyle; Visible: false; } }

      Group {
        Anchor: (Horizontal: 0, Height: 1, Top: 6, Bottom: 12);
        Background: (Color: #3a465c);
      }

      Label #IslandsDangerSectionTitle { Anchor: (Horizontal: 0, Height: 22, Bottom: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #ffffff, RenderBold: true); Text: "Danger zone"; }
      Label #IslandsDangerSectionDescription { Anchor: (Horizontal: 0, Height: 16, Bottom: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3); Text: ""; }

      Group {
        Anchor: (Horizontal: 0, Height: 40, Bottom: 10);
        LayoutMode: Left;

        TextButton #IslandsDeleteButton {
          Anchor: (Height: 36);
          Padding: (Horizontal: 18);
          Text: "Delete";
          Style: @SecondaryTextButtonStyle;
        }
      }
    }

    Group {
      Anchor: (Horizontal: 0, Height: 42, Top: 10);
      LayoutMode: Right;

      TextButton #IslandsViewerBackButton {
        Anchor: (Height: 36);
        Padding: (Horizontal: 16);
        Text: "Back";
        Style: @SecondaryTextButtonStyle;
      }
    }
  }
}