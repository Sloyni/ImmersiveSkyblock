$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@AddonsSection = Group {
        LayoutMode: Top;
        Visible: false;

        Group {
          Anchor: (Horizontal: 0, Height: 1, Top: 10, Bottom: 14);
          Background: (Color: #3a465c);
        }

        Group {
          Anchor: (Horizontal: 0, Bottom: 12);
          LayoutMode: Left;

          Group {
            FlexWeight: 1;
            LayoutMode: Top;

            Label #AddonsSectionTitle {
              Anchor: (Horizontal: 0, Height: 26, Bottom: 2);
              Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
              Text: "Addons disponibles";
            }

            Label #AddonsSectionDescription {
              Anchor: (Horizontal: 0, Height: 18);
              Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
              Text: "Activez ou desactivez les addons du plugin.";
            }
          }

          Group {
            Anchor: (Width: 32, Height: 32, Top: 2);
          }
        }

      Group #AddonRow0 { Anchor: (Height: 60, Horizontal: 0, Bottom: 4); LayoutMode: Left; Background: (Color: #223149); Padding: (Left: 12, Right: 10); Visible: false;
        Group {
          Anchor: (Width: 34, Right: 10);
          LayoutMode: Middle;
          $C.@CheckBox #AddonEnabled0 { @Anchor = (Width: 22, Height: 22, Vertical: 0); Value: false; Visible: false; }
        }
        Group { FlexWeight: 1; Anchor: (Vertical: 0); LayoutMode: Top; Padding: (Top: 8);
          Label #AddonName0 { Anchor: (Horizontal: 0, Height: 22, Top: 2); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true); Text: ""; }
          Label #AddonSubId0 { Anchor: (Horizontal: 0, Height: 14); Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a8e9e, VerticalAlignment: Center); Text: ""; }
        }
      }
