$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@EditTemplateFormSection = Group {
  Anchor: (Horizontal: 0, Bottom: 14);
  LayoutMode: Top;
  Visible: false;

  Group {
    Anchor: (Horizontal: 0, Height: 24, Bottom: 6);
    LayoutMode: Left;

    Label #EditTemplateFormTitle {
      Anchor: (Height: 24, Right: 6);
      Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
      Text: "Modifier le template";
    }

    Label #EditTemplateIdInline {
      Anchor: (Height: 24);
      Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a9cc6, VerticalAlignment: Center);
      Text: "";
      Visible: false;
    }
  }

  Label #EditTemplateFormIntro {
    Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
    Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
    Text: "Modifiez les textes puis enregistrez pour revenir au menu principal.";
  }

  Group #EditTemplateLanguageTabs {
    Anchor: (Horizontal: 0, Height: 40, Bottom: 8);
    LayoutMode: Left;
    Visible: false;

    Group {
      Anchor: (Width: 108, Height: 32, Right: 6);
      $C.@SmallTertiaryTextButton #EditLang0 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "EN"; Visible: false; }
      $C.@SmallSecondaryTextButton #EditLangActive0 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "EN"; Visible: false; }
    }
    Group {
      Anchor: (Width: 108, Height: 32, Right: 6);
      $C.@SmallTertiaryTextButton #EditLang1 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "FR"; Visible: false; }
      $C.@SmallSecondaryTextButton #EditLangActive1 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "FR"; Visible: false; }
    }
    Group {
      Anchor: (Width: 108, Height: 32, Right: 6);
      $C.@SmallTertiaryTextButton #EditLang2 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "DE"; Visible: false; }
      $C.@SmallSecondaryTextButton #EditLangActive2 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "DE"; Visible: false; }
    }
    Group {
      Anchor: (Width: 108, Height: 32, Right: 6);
      $C.@SmallTertiaryTextButton #EditLang3 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "ES"; Visible: false; }
      $C.@SmallSecondaryTextButton #EditLangActive3 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "ES"; Visible: false; }
    }
    Group {
      Anchor: (Width: 108, Height: 32, Right: 6);
      $C.@SmallTertiaryTextButton #EditLang4 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "IT"; Visible: false; }
      $C.@SmallSecondaryTextButton #EditLangActive4 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "IT"; Visible: false; }
    }
    Group {
      Anchor: (Width: 108, Height: 32, Right: 6);
      $C.@SmallTertiaryTextButton #EditLang5 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "PT"; Visible: false; }
      $C.@SmallSecondaryTextButton #EditLangActive5 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "PT"; Visible: false; }
    }
    Group {
      Anchor: (Width: 108, Height: 32, Right: 6);
      $C.@SmallTertiaryTextButton #EditLang6 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "RU"; Visible: false; }
      $C.@SmallSecondaryTextButton #EditLangActive6 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "RU"; Visible: false; }
    }
    Group {
      Anchor: (Width: 108, Height: 32);
      $C.@SmallTertiaryTextButton #EditLang7 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "JA"; Visible: false; }
      $C.@SmallSecondaryTextButton #EditLangActive7 { @Sounds = $Sounds.@ButtonsLight; @Anchor = (Horizontal: 0, Height: 32); Padding: (Left: 8, Right: 8); Text: "JA"; Visible: false; }
    }
  }

  Label #EditTemplateLanguageHint {
    Anchor: (Horizontal: 0, Height: 20, Bottom: 8);
    Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a9cc6);
    Text: "";
    Visible: false;
  }

  Label #EditTemplateFormNameLabel {
    Anchor: (Height: 22, Bottom: 4);
    Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b8c7d8);
    Text: "Nom";
  }

  $C.@TextField #EditTemplateNameField {
    @Anchor = (Horizontal: 0, Bottom: 10);
  }

  Label #EditTemplateFormDescriptionLabel {
    Anchor: (Height: 22, Bottom: 4);
    Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b8c7d8);
    Text: "Description";
  }

  $C.@MultilineTextField #EditTemplateDescriptionField {
    @Anchor = (Horizontal: 0, Height: 68, Bottom: 10);
  }

  Label #EditTemplateFormError {
    Anchor: (Horizontal: 0, Height: 24, Bottom: 6);
    Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ff5555, HorizontalAlignment: Center);
    Text: "";
    Visible: false;
  }

  Group {
    Anchor: (Horizontal: 0, Height: 48);
    LayoutMode: Left;

    Group { FlexWeight: 1; }

    $C.@SecondaryTextButton #CancelEditTemplateFormButton {
      @Sounds = $Sounds.@ButtonsCancel;
      @Anchor = (Width: 138, Right: 8);
      Text: "Annuler";
    }

    $C.@TextButton #SaveEditTemplateFormButton {
      @Sounds = $Sounds.@ButtonsLight;
      @Anchor = (Width: 164);
      Text: "Enregistrer";
    }
  }
};
