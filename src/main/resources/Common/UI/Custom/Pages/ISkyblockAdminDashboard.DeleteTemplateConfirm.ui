$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@DeleteTemplateConfirmSection = Group {
  Anchor: (Horizontal: 0, Bottom: 14);
  LayoutMode: Top;
  Background: (Color: #26191b(0.92));
  Padding: (Full: 16);
  Visible: false;

  Label #DeleteTemplateConfirmTitle {
    Anchor: (Height: 24, Bottom: 6);
    Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #ff8080, RenderBold: true);
    Text: "Confirmer la suppression";
  }

  Label #DeleteTemplateConfirmDescription {
    Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
    Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #b49ca0);
    Text: "Cette action est definitive. Le template sera supprime du disque.";
  }

  Label #DeleteTemplateConfirmTemplateText {
    Anchor: (Horizontal: 0, Height: 22, Bottom: 10);
    Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, RenderBold: true);
    Text: "";
  }

  Label #DeleteTemplateConfirmError {
    Anchor: (Horizontal: 0, Height: 24, Bottom: 6);
    Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ff6666, HorizontalAlignment: Center);
    Text: "";
    Visible: false;
  }

  Group {
    Anchor: (Horizontal: 0, Height: 48);
    LayoutMode: Left;

    Group { FlexWeight: 1; }

    $C.@SecondaryTextButton #CancelDeleteTemplateButton {
      @Sounds = $Sounds.@ButtonsCancel;
      @Anchor = (Width: 138, Right: 8);
      Text: "Annuler";
    }

    $C.@CancelTextButton #ConfirmDeleteTemplateButton {
      @Sounds = $Sounds.@ButtonsCancel;
      @Anchor = (Width: 164);
      Text: "Supprimer";
    }
  }
};
