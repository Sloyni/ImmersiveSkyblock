$C = "../Common.ui";
$Sounds = "../Sounds.ui";

        @IslandMenuHomesSection = Group {
          Anchor: (Horizontal: 0, Vertical: 0);
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Visible: false;

          Group {
            Anchor: (Horizontal: 0, Bottom: 10);
            LayoutMode: Left;

            Group {
              FlexWeight: 1;
              LayoutMode: Top;

              Label #HomesSectionTitle {
                Anchor: (Horizontal: 0, Height: 24);
                Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
                Text: "Homes";
              }

              Label #HomesSectionDescription {
                Anchor: (Horizontal: 0, Height: 16, Top: 2);
                Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
                Text: "Manage your island homes.";
              }
            }

            Group { Anchor: (Width: 8); }

            $C.@SmallSecondaryTextButton #BtnHomesSetOpen {
              @Anchor = (Width: 190, Height: 32);
              Text: "Set home (0/0)";
            }
          }

          Group #HomesTableHeader {
            Anchor: (Height: 30, Horizontal: 0, Bottom: 4);
            LayoutMode: Left;
            Background: (Color: #101925);
            Padding: (Left: 10, Right: 10);

            Label #HomesHeaderHome {
              Anchor: (Width: 330, Height: 18, Vertical: 0);
              Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #8fa5b7, RenderBold: true, VerticalAlignment: Center);
              Text: "Home";
            }

            Group { FlexWeight: 1; }

            Label #HomesHeaderActions {
              Anchor: (Width: 300, Height: 18, Vertical: 0);
              Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #8fa5b7, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
              Text: "Actions";
            }
          }

          Label #HomesEmptyLabel {
            Anchor: (Horizontal: 0, Height: 18, Bottom: 4);
            Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #6f8495);
            Text: "No homes created yet.";
            Visible: false;
          }

          Group #HomesRow0 {
            Anchor: (Height: 44, Horizontal: 0, Bottom: 4);
            LayoutMode: Left;
            Background: (Color: #223149);
            Padding: (Left: 10, Right: 10);
            Visible: false;
            Label #HomeName0 { Anchor: (Width: 330, Height: 18, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center); Text: ""; }
            Group { FlexWeight: 1; }
            Group #HomeRenameBox0 { Anchor: (Width: 32, Height: 32); Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12); Button #BtnHomeRename0 { Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0); Style: (Default: (Background: (TexturePath: "../icons/pen.png", Color: #9bb4ce)), Hovered: (Background: (TexturePath: "../icons/pen.png", Color: #ffffff)), Pressed: (Background: (TexturePath: "../icons/pen.png", Color: #7f9cb9)), Disabled: (Background: (TexturePath: "../icons/pen.png", Color: #5a6d80))); } }
            Group { Anchor: (Width: 6); }
            Group #HomeDeleteBox0 { Anchor: (Width: 32, Height: 32); Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12); Button #BtnHomeDelete0 { Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0); Style: (Default: (Background: (TexturePath: "../icons/trash.png", Color: #d4a4a4)), Hovered: (Background: (TexturePath: "../icons/trash.png", Color: #ffcccc)), Pressed: (Background: (TexturePath: "../icons/trash.png", Color: #b78989)), Disabled: (Background: (TexturePath: "../icons/trash.png", Color: #725959))); } }
            Group { Anchor: (Width: 6); }
            $C.@SmallSecondaryTextButton #BtnHomeGo0 { @Anchor = (Width: 70, Height: 32); Text: "Go"; }
          }
          Group #HomesRow1 {
            Anchor: (Height: 44, Horizontal: 0, Bottom: 4);
            LayoutMode: Left;
