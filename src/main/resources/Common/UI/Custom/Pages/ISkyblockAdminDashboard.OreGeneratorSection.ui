$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@OreGeneratorSection = Group {
  LayoutMode: Top;
  Visible: false;

  Group {
    Anchor: (Horizontal: 0, Height: 1, Top: 10, Bottom: 14);
    Background: (Color: #3a465c);
  }

  Group {
    Anchor: (Horizontal: 0, Bottom: 12);
    LayoutMode: Left;

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #OreGenSectionTitle {
        Anchor: (Horizontal: 0, Height: 26, Bottom: 2);
        Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
        Text: "Ore Generator";
      }

      Label #OreGenSectionDescription {
        Anchor: (Horizontal: 0, Height: 18);
        Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7f8fa3);
        Text: "Configure ore generation when cobblestone is created.";
      }
    }
  }

  Group #OreGenOreChanceRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group { FlexWeight: 1; Anchor: (Vertical: 0); LayoutMode: Middle;
      Label #OreGenOreChanceLabel { Anchor: (Horizontal: 0, Height: 22, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true); Text: "Ore chance"; }
    }

    Group #OreGenOreChanceFieldBorder { Anchor: (Width: 122, Height: 32, Right: 8); Padding: (Full: 2);
      $C.@TextField #OreGenOreChanceField { @Anchor = (Horizontal: 0, Height: 28, Vertical: 0); }
    }

    Group #OreGenOreChanceApplyBox { Anchor: (Width: 32, Height: 32); Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12); Visible: false;
      Button #OreGenOreChanceApply { Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0); Style: (Default: (Background: (TexturePath: "../icons/check.png", Color: #9bb4ce)), Hovered: (Background: (TexturePath: "../icons/check.png", Color: #ffffff)), Pressed: (Background: (TexturePath: "../icons/check.png", Color: #7f9cb9)), Disabled: (Background: (TexturePath: "../icons/check.png", Color: #5a6d80))); }
    }
  }

  Group #OreGenRegenDelayRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 4);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group { FlexWeight: 1; Anchor: (Vertical: 0); LayoutMode: Middle;
      Label #OreGenRegenDelayLabel { Anchor: (Horizontal: 0, Height: 22, Vertical: 0); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true); Text: "Regen delay (ms)"; }
    }

    Group #OreGenRegenDelayFieldBorder { Anchor: (Width: 122, Height: 32, Right: 8); Padding: (Full: 2);
      $C.@TextField #OreGenRegenDelayField { @Anchor = (Horizontal: 0, Height: 28, Vertical: 0); }
    }

    Group #OreGenRegenDelayApplyBox { Anchor: (Width: 32, Height: 32); Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12); Visible: false;
      Button #OreGenRegenDelayApply { Anchor: (Width: 18, Height: 18, Horizontal: 0, Vertical: 0); Style: (Default: (Background: (TexturePath: "../icons/check.png", Color: #9bb4ce)), Hovered: (Background: (TexturePath: "../icons/check.png", Color: #ffffff)), Pressed: (Background: (TexturePath: "../icons/check.png", Color: #7f9cb9)), Disabled: (Background: (TexturePath: "../icons/check.png", Color: #5a6d80))); }
    }
  }

  Group #OreGenSpawnRubbleRow {
    Anchor: (Height: 60, Horizontal: 0, Bottom: 8);
    LayoutMode: Left;
    Background: (Color: #223149);
    Padding: (Left: 12, Right: 10);

    Group {
      Anchor: (Width: 34, Right: 10);
      LayoutMode: Middle;
      $C.@CheckBox #OreGenSpawnRubbleToggle {
        @Anchor = (Width: 22, Height: 22, Vertical: 0);
        Value: false;
      }
    }

    Group {
      FlexWeight: 1;
      Anchor: (Vertical: 0);
      LayoutMode: Middle;

      Label #OreGenSpawnRubbleLabel {
        Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true);
        Text: "Spawn rubble particles on generation";
      }
    }
  }

  Group {
    Anchor: (Horizontal: 0, Bottom: 4);
    LayoutMode: Top;

    Group {
      Anchor: (Horizontal: 0, Height: 1, Top: 14, Bottom: 10);
      Background: (Color: #3a465c);
    }

    Label #OreGenOresSectionTitle {
      Anchor: (Horizontal: 0, Height: 26, Bottom: 4);
      Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #ffffff, RenderBold: true);
      Text: "Configured ores";
    }
  }

  Group #OreGenCreateRow {
    Anchor: (Height: 52, Horizontal: 0, Bottom: 6);
    LayoutMode: Left;
    Background: (Color: #1a2738);
    Padding: (Left: 10, Right: 10);

    Group { 
        FlexWeight: 3; 
        Anchor: (Height: 32, Right: 8);
      Padding: (Full: 2);
      $C.@TextField #OreGenCreateBlockIdField { @Anchor = (Horizontal: 0, Height: 28, Vertical: 0); }
    }

    Group { 
        FlexWeight: 2;
        Anchor: (Height: 32, Right: 8); 
        Padding: (Full: 2);
      $C.@TextField #OreGenCreateWeightField { @Anchor = (Horizontal: 0, Height: 28, Vertical: 0); }
    }

    TextButton #OreGenCreateButton {
      Anchor: (Width: 112, Height: 32);
      Text: "Create";
      Style: (
        Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Sounds: $Sounds.@ButtonsLight
      );
    }
  }

  Group #OreGenSearchRow {
    Anchor: (Height: 52, Horizontal: 0, Bottom: 6);
    LayoutMode: Left;
    Background: (Color: #1a2738);
    Padding: (Left: 10, Right: 10);

    Group { FlexWeight: 1; Anchor: (Height: 32, Right: 8);
      $C.@TextField #OreGenSearchField { @Anchor = (Horizontal: 0, Height: 32, Vertical: 0); }
    }

    TextButton #OreGenSearchButton {
      Anchor: (Width: 112, Height: 32);
      Text: "Search";
      Style: (
        Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9bb4ce, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #7f9cb9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Disabled: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12), LabelStyle: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #5a6d80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Sounds: $Sounds.@ButtonsLight
      );
    }
  }

  Label #OreGenSectionError {
    Anchor: (Horizontal: 0, Height: 24, Top: 8);
    Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ff5555, HorizontalAlignment: Center);
    Text: "";
    Visible: false;
  }

