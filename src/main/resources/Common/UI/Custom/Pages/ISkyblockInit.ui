$C = "../Common.ui";
$Sounds = "../Sounds.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 820);

    #Title {
      $C.@Title {
        @Text = "";
      }
      Label #PageTitle {
        Style: (...$C.@DefaultLabelStyle, FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center);
        Anchor: (Height: 30);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 20);

      Label #Subtitle {
        Anchor: (Bottom: 10);
        Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #b8cce0, HorizontalAlignment: Center);
        Text: "";
      }

      Group #WelcomeStep {
        Anchor: (Horizontal: 0, Height: 132, Bottom: 12);
        Background: (Color: #223149);
        LayoutMode: Top;
        Padding: (Left: 18, Right: 18, Top: 18, Bottom: 14);

        Label #WelcomeTitle {
          Anchor: (Horizontal: 0, Height: 30);
          Style: (...$C.@DefaultLabelStyle, FontSize: 22, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center);
          Text: "";
        }

        Label #WelcomeSubtitle {
          Anchor: (Horizontal: 0, Height: 42, Top: 8);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #a5bfd8, HorizontalAlignment: Center, Wrap: true, RenderUppercase: false);
          Text: "";
        }
      }

      Label #StepIndicator {
        Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #85a9ca, HorizontalAlignment: Center, RenderUppercase: false);
        Text: "";
      }

      Label #StepError {
        Anchor: (Horizontal: 0, Height: 18, Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #ff8f8f, HorizontalAlignment: Center, RenderUppercase: false);
        Visible: false;
        Text: "";
      }

      Group #LanguageStep {
        Anchor: (Height: 60, Horizontal: 0, Bottom: 6);
        LayoutMode: Left;
        Background: (Color: #223149);
        Padding: (Left: 12, Right: 10);
        Visible: false;

        Group {
          FlexWeight: 1;
          Anchor: (Vertical: 0);
          LayoutMode: Middle;

          Label #LangQuestionLabel {
            Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
            Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true, RenderUppercase: false);
            Text: "";
          }
        }

        Group {
          Anchor: (Width: 200, Height: 32, Right: 0);
          LayoutMode: Middle;

          DropdownBox #LangDropdown {
            Anchor: (Horizontal: 0, Height: 32, Vertical: 0);
            Style: $C.@DefaultDropdownBoxStyle;
          }
        }
      }

      Group #WorldStep {
        Anchor: (Height: 60, Horizontal: 0, Bottom: 6);
        LayoutMode: Left;
        Background: (Color: #223149);
        Padding: (Left: 12, Right: 10);
        Visible: false;

        Group {
          FlexWeight: 1;
          Anchor: (Vertical: 0);
          LayoutMode: Middle;

          Label #WorldQuestionLabel {
            Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
            Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true, RenderUppercase: false);
            Text: "";
          }
        }

        Group {
          Anchor: (Width: 230, Height: 38, Right: 0);
          LayoutMode: Middle;
          $C.@TextField #WorldInput {
            @Anchor = (Horizontal: 0, Height: 38, Vertical: 0);
          }
        }
      }

      Group #SpacingStep {
        Anchor: (Height: 60, Horizontal: 0, Bottom: 6);
        LayoutMode: Left;
        Background: (Color: #223149);
        Padding: (Left: 12, Right: 10);
        Visible: false;

        Group {
          FlexWeight: 1;
          Anchor: (Vertical: 0);
          LayoutMode: Middle;

          Label #SpacingQuestionLabel {
            Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
            Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true, RenderUppercase: false);
            Text: "";
          }
        }

        Group {
          Anchor: (Width: 230, Height: 38, Right: 0);
          LayoutMode: Middle;
          $C.@TextField #SpacingInput {
            @Anchor = (Horizontal: 0, Height: 38, Vertical: 0);
          }
        }
      }

      Group #ZoneSizeStep {
        Anchor: (Height: 60, Horizontal: 0, Bottom: 6);
        LayoutMode: Left;
        Background: (Color: #223149);
        Padding: (Left: 12, Right: 10);
        Visible: false;

        Group {
          FlexWeight: 1;
          Anchor: (Vertical: 0);
          LayoutMode: Middle;

          Label #ZoneSizeQuestionLabel {
            Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
            Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true, RenderUppercase: false);
            Text: "";
          }
        }

        Group {
          Anchor: (Width: 230, Height: 38, Right: 0);
          LayoutMode: Middle;
          $C.@TextField #ZoneSizeInput {
            @Anchor = (Horizontal: 0, Height: 38, Vertical: 0);
          }
        }
      }

      Group #MaxResetsStep {
        Anchor: (Height: 102, Horizontal: 0, Bottom: 6);
        LayoutMode: Top;
        Background: (Color: #223149);
        Padding: (Left: 12, Right: 10);
        Visible: false;

        Group {
          Anchor: (Horizontal: 0, Height: 40, Bottom: 12);
          LayoutMode: Left;

          Label #MaxResetsQuestionLabel {
            Anchor: (Height: 22, Vertical: 0);
            FlexWeight: 1;
            Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true, RenderUppercase: false);
            Text: "";
          }

          $C.@TextField #MaxResetsInput {
            @Anchor = (Width: 230, Height: 32, Vertical: 0);
          }
        }

        Group {
          Anchor: (Horizontal: 0, Height: 40);
          LayoutMode: Left;

          Label #MaxHomesQuestionLabel {
            Anchor: (Height: 22, Vertical: 0);
            FlexWeight: 1;
            Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true, RenderUppercase: false);
            Text: "";
          }

          $C.@TextField #MaxHomesInput {
            @Anchor = (Width: 230, Height: 32, Vertical: 0);
          }
        }
      }

      Group #DefaultBlockValueStep {
        Anchor: (Height: 60, Horizontal: 0, Bottom: 14);
        LayoutMode: Left;
        Background: (Color: #223149);
        Padding: (Left: 12, Right: 10);
        Visible: false;

        Group {
          FlexWeight: 1;
          Anchor: (Vertical: 0);
          LayoutMode: Middle;

          Label #DefaultBlockValueQuestionLabel {
            Anchor: (Horizontal: 0, Height: 22, Vertical: 0);
            Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center, RenderBold: true, RenderUppercase: false);
            Text: "";
          }
        }

        Group {
          Anchor: (Width: 230, Height: 38, Right: 0);
          LayoutMode: Middle;
          $C.@TextField #DefaultBlockValueInput {
            @Anchor = (Horizontal: 0, Height: 38, Vertical: 0);
          }
        }
      }

      Group #SummaryStep {
        Anchor: (Horizontal: 0, Height: 202, Bottom: 8);
        Background: (Color: #223149);
        LayoutMode: Top;
        Padding: (Left: 14, Right: 14, Top: 12, Bottom: 10);
        Visible: false;

        Label #SummaryTitle {
          Anchor: (Horizontal: 0, Height: 24, Bottom: 8);
          Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #ffffff, RenderBold: true, RenderUppercase: false);
          Text: "";
        }

        Label #SummaryLanguage {
          Anchor: (Horizontal: 0, Height: 20, Bottom: 2);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #b7cedd, RenderUppercase: false);
          Text: "";
        }

        Label #SummaryWorld {
          Anchor: (Horizontal: 0, Height: 20, Bottom: 2);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #b7cedd, RenderUppercase: false);
          Text: "";
        }

        Label #SummarySpacing {
          Anchor: (Horizontal: 0, Height: 20, Bottom: 2);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #b7cedd, RenderUppercase: false);
          Text: "";
        }

        Label #SummaryZoneSize {
          Anchor: (Horizontal: 0, Height: 20, Bottom: 2);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #b7cedd, RenderUppercase: false);
          Text: "";
        }

        Label #SummaryMaxResets {
          Anchor: (Horizontal: 0, Height: 20, Bottom: 2);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #b7cedd, RenderUppercase: false);
          Text: "";
        }

        Label #SummaryMaxHomes {
          Anchor: (Horizontal: 0, Height: 20, Bottom: 2);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #b7cedd, RenderUppercase: false);
          Text: "";
        }

        Label #SummaryBlockValue {
          Anchor: (Horizontal: 0, Height: 20);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #b7cedd, RenderUppercase: false);
          Text: "";
        }
      }

      Group {
        Anchor: (Height: 12);
      }

      Group {
        LayoutMode: Center;

        $C.@SecondaryTextButton #BackButton {
          @Sounds = $Sounds.@ButtonsLight;
          @Anchor = (Width: 130, Right: 6);
          Text: "";
        }

        $C.@TextButton #NextButton {
          @Sounds = $Sounds.@ButtonsLight;
          @Anchor = (Width: 130, Right: 6);
          Text: "";
        }

        $C.@TextButton #FinishButton {
          @Sounds = $Sounds.@ButtonsLight;
          @Anchor = (Width: 130, Right: 6);
          Text: "";
        }

        $C.@SecondaryTextButton #CancelButton {
          @Sounds = $Sounds.@ButtonsCancel;
          @Anchor = (Width: 130, Left: 6);
          Text: "";
        }
      }
    }
  }
}
